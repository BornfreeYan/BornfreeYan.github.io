---
import Layout from '../layouts/Layout.astro'
---

<Layout title="404">
  <div class="mx-auto flex min-h-[60vh] max-w-3xl flex-col items-center justify-center px-4 text-center">
    <p class="font-serif text-6xl font-semibold text-accent">404</p>
    <p class="mt-4 text-muted">页面不存在，可能已移动或删除。</p>
    <a
      href="/"
      class="mt-8 rounded-lg bg-accent px-5 py-2 text-sm text-bg transition-opacity hover:opacity-90"
    >
      回到首页
    </a>
  </div>
</Layout>