---
import Layout from '../layouts/Layout.astro'
import ProjectCard from '../components/ProjectCard.astro'
import projectsData from '../data/projects.json'
import type { Project } from '../types'

const projects = (projectsData as { projects: Project[] }).projects
---

<Layout title="Projects">
  <div class="mx-auto max-w-5xl px-4 py-16">
    <h1 class="font-serif text-3xl font-semibold">Projects</h1>
    <p class="mt-2 text-muted">
      我的项目。
      <a
        href="https://github.com/BornfreeYan"
        target="_blank"
        rel="noopener noreferrer"
        class="text-accent underline underline-offset-2"
      >
        GitHub
      </a>
      →
    </p>
    <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </div>
</Layout>

<script>
  import { fetchRepoStars } from '../lib/github'

  document.querySelectorAll<HTMLElement>('[data-stars]').forEach(async (el) => {
    const url = el.getAttribute('data-stars') ?? ''
    const stars = await fetchRepoStars(url)
    const value = el.querySelector<HTMLElement>('[data-stars-value]')
    if (stars !== null && value) {
      value.textContent = stars > 0 ? String(stars) : '0'
    }
  })
</script>