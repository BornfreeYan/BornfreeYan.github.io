---
import Layout from '../../layouts/Layout.astro'
import ArticleCard from '../../components/ArticleCard.astro'
import Pagination from '../../components/Pagination.astro'
import { getSortedArticles, getPageCount, PAGE_SIZE } from '../../lib/articles'

const all = await getSortedArticles()
const pageCount = getPageCount(all.length)
const articles = all.slice(0, PAGE_SIZE)
---

<Layout title="Articles">
  <div class="mx-auto max-w-5xl px-4 py-16">
    <div class="mb-8 flex items-end justify-between">
      <h1 class="font-serif text-3xl font-semibold">Articles</h1>
      <span class="text-sm text-muted">共 {all.length} 篇</span>
    </div>
    <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
      {
        articles.length > 0 ? (
          articles.map((a) => <ArticleCard article={a} />)
        ) : (
          <p class="text-muted">暂无文章</p>
        )
      }
    </div>
    {pageCount > 1 && <Pagination current={1} pageCount={pageCount} />}
  </div>
</Layout>