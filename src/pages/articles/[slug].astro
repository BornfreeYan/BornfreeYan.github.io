---
import Layout from '../../layouts/Layout.astro'
import { getCollection, render } from 'astro:content'
import { formatDate, countWords } from '../../lib/format'
import { getSortedArticles } from '../../lib/articles'
import TableOfContents from '../../components/TableOfContents.astro'

export async function getStaticPaths() {
  const articles = await getCollection('articles')
  return articles.map((a) => ({ params: { slug: a.id }, props: { article: a } }))
}

const { article } = Astro.props
const { Content, headings } = await render(article)

const all = await getSortedArticles()
const idx = all.findIndex((a) => a.id === article.id)
const prev = idx > 0 ? all[idx - 1] : null
const next = idx < all.length - 1 ? all[idx + 1] : null

const { title, date, categories, tags, cover } = article.data
const words = countWords(article.body ?? '')
const readMin = Math.max(1, Math.round(words / 300))
---

<Layout title={title}>
  <div
    data-reading-bar
    class="pointer-events-none fixed inset-x-0 top-0 z-[60] h-0.5 bg-line/60"
  >
    <div
      data-reading-fill
      class="h-full origin-left bg-accent"
      style="transform: scaleX(0)"
    ></div>
  </div>

  <div class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,768px)_220px] lg:justify-center">
      <article class="min-w-0">
        <header class="mb-10">
          <div class="flex flex-wrap items-center gap-2 text-sm text-muted">
            <time datetime={date.toISOString()}>{formatDate(date)}</time>
            <span aria-hidden="true">·</span>
            <span>{words} 字</span>
            <span aria-hidden="true">·</span>
            <span>约 {readMin} 分钟</span>
            {categories.map((c) => (
              <a
                href={`/categories/${encodeURIComponent(c)}`}
                class="rounded-full bg-line/60 px-2 py-0.5 transition-colors hover:text-accent"
              >
                {c}
              </a>
            ))}
          </div>
          <h1 class="mt-4 font-serif text-3xl font-semibold leading-tight sm:text-4xl">{title}</h1>
      <div class="mt-4 flex flex-wrap gap-1.5">
        {tags.map((t) => (
          <a
            href={`/tags/${encodeURIComponent(t)}`}
            class="rounded-full border border-line px-2 py-0.5 text-xs text-muted transition-colors hover:border-accent hover:text-accent"
          >
            #{t}
          </a>
        ))}
      </div>
      {
        cover && (
          <div class="mt-6 aspect-video w-full overflow-hidden rounded-xl border border-line bg-line/50">
            <img src={cover} alt={title} class="h-full w-full object-cover" />
          </div>
        )
      }
    </header>

        <div class="prose">
          <Content />
        </div>

        <nav class="mt-16 flex items-center justify-between gap-4 border-t border-line pt-6 text-sm">
          {
            prev ? (
              <a
                href={`/articles/${prev.id}/`}
                class="max-w-[45%] text-muted transition-colors hover:text-accent"
              >
                ← {prev.data.title}
              </a>
            ) : (
              <span></span>
            )
          }
          {
            next ? (
              <a
                href={`/articles/${next.id}/`}
                class="max-w-[45%] text-right text-muted transition-colors hover:text-accent"
              >
                {next.data.title} →
              </a>
            ) : (
              <span></span>
            )
          }
        </nav>
      </article>

      <aside class="hidden lg:block">
        <div class="sticky top-28 max-h-[calc(100vh-8rem)] overflow-y-auto pb-4">
          <TableOfContents headings={headings} />
        </div>
      </aside>
    </div>
  </div>
</Layout>

<script>
  const bar = document.querySelector<HTMLElement>('[data-reading-bar]')
  const fill = document.querySelector<HTMLElement>('[data-reading-fill]')
  if (bar && fill) {
    const update = () => {
      const doc = document.documentElement
      const total = doc.scrollHeight - window.innerHeight
      const p = total > 0 ? window.scrollY / total : 0
      fill.style.transform = `scaleX(${Math.min(1, Math.max(0, p))})`
    }
    addEventListener('scroll', update, { passive: true })
    addEventListener('resize', update)
    update()
  }
</script>
