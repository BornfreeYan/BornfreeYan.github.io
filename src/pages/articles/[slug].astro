---
import Layout from '../../layouts/Layout.astro'
import 'katex/dist/katex.min.css'
import { getCollection, render } from 'astro:content'
import { formatDate, countWords } from '../../lib/format'
import { getSortedArticles } from '../../lib/articles'
import TableOfContents from '../../components/TableOfContents.astro'

export async function getStaticPaths() {
  const articles = await getCollection('articles')
  return articles.map((a) => ({ params: { slug: a.id }, props: { article: a } }))
}

const { article } = Astro.props
const { Content, headings } = await render(article)

const all = await getSortedArticles()
const idx = all.findIndex((a) => a.id === article.id)
const prev = idx > 0 ? all[idx - 1] : null
const next = idx < all.length - 1 ? all[idx + 1] : null

const { title, date, categories, tags, cover } = article.data
const words = countWords(article.body ?? '')
const readMin = Math.max(1, Math.round(words / 300))
---

<Layout title={title}>
  <div
    data-reading-bar
    class="pointer-events-none fixed inset-x-0 top-0 z-[60] h-0.5 bg-line/60"
  >
    <div
      data-reading-fill
      class="h-full origin-left bg-accent"
      style="transform: scaleX(0)"
    ></div>
  </div>

  <div class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,768px)_220px] lg:justify-center">
      <article class="min-w-0">
        <header class="mb-10">
          <div class="flex flex-wrap items-center gap-2 text-sm text-muted">
            <time datetime={date.toISOString()}>{formatDate(date)}</time>
            <span aria-hidden="true">·</span>
            <span>{words} 字</span>
            <span aria-hidden="true">·</span>
            <span>约 {readMin} 分钟</span>
            {categories.map((c) => (
              <a
                href={`/categories/${encodeURIComponent(c)}`}
                class="rounded-full bg-line/60 px-2 py-0.5 transition-colors hover:text-accent"
              >
                {c}
              </a>
            ))}
          </div>
          <h1 class="mt-4 font-serif text-3xl font-semibold leading-tight sm:text-4xl">{title}</h1>
      <div class="mt-4 flex flex-wrap gap-1.5">
        {tags.map((t) => (
          <a
            href={`/tags/${encodeURIComponent(t)}`}
            class="rounded-full border border-line px-2 py-0.5 text-xs text-muted transition-colors hover:border-accent hover:text-accent"
          >
            #{t}
          </a>
        ))}
      </div>
      {
        cover && (
          <div class="mt-6 aspect-video w-full overflow-hidden rounded-xl border border-line bg-line/50">
            <img src={cover} alt={title} class="h-full w-full object-cover" />
          </div>
        )
      }
    </header>

        <div class="prose">
          <Content />
        </div>

        <nav class="mt-16 flex items-center justify-between gap-4 border-t border-line pt-6 text-sm">
          {
            prev ? (
              <a
                href={`/articles/${prev.id}/`}
                class="max-w-[45%] text-muted transition-colors hover:text-accent"
              >
                ← {prev.data.title}
              </a>
            ) : (
              <span></span>
            )
          }
          {
            next ? (
              <a
                href={`/articles/${next.id}/`}
                class="max-w-[45%] text-right text-muted transition-colors hover:text-accent"
              >
                {next.data.title} →
              </a>
            ) : (
              <span></span>
            )
          }
        </nav>
      </article>

      <aside class="hidden lg:block">
        <div class="sticky top-28 max-h-[calc(100vh-8rem)] overflow-y-auto pb-4">
          <TableOfContents headings={headings} />
        </div>
      </aside>
    </div>
  </div>
</Layout>

<script>
  const bar = document.querySelector<HTMLElement>('[data-reading-bar]')
  const fill = document.querySelector<HTMLElement>('[data-reading-fill]')
  if (bar && fill) {
    const update = () => {
      const doc = document.documentElement
      const total = doc.scrollHeight - window.innerHeight
      const p = total > 0 ? window.scrollY / total : 0
      fill.style.transform = `scaleX(${Math.min(1, Math.max(0, p))})`
    }
    addEventListener('scroll', update, { passive: true })
    addEventListener('resize', update)
    update()
  }
</script>

<script>
  // 文章包含 mermaid 代码块时才动态加载 mermaid，把代码块替换为图表
  async function setupMermaid() {
    const pres = Array.from(
      document.querySelectorAll<HTMLPreElement>('.prose pre[data-language="mermaid"]'),
    )
    if (pres.length === 0) return

    type MermaidAPI = (typeof import('mermaid'))['default']
    let mermaid: MermaidAPI
    try {
      mermaid = (await import('mermaid')).default
    } catch {
      return
    }

    // 滚轮直接平移图形；仅横向溢出时把 deltaY 映射为横向，到边界后交还页面滚动
    function enableWheelPan(el: HTMLElement) {
      el.addEventListener(
        'wheel',
        (e) => {
          const overX = el.scrollWidth - el.clientWidth
          const overY = el.scrollHeight - el.clientHeight
          if (overX <= 0 && overY <= 0) return
          const rawX = e.deltaX + (e.shiftKey ? e.deltaY : 0)
          const rawY = e.shiftKey ? 0 : e.deltaY
          const dx = overX > 0 ? rawX + (overY > 0 ? 0 : rawY) : 0
          const dy = overY > 0 ? rawY : 0
          if (dx === 0 && dy === 0) return
          const stuckX =
            dx !== 0 && ((dx < 0 && el.scrollLeft <= 1) || (dx > 0 && el.scrollLeft >= overX - 1))
          const stuckY =
            dy !== 0 && ((dy < 0 && el.scrollTop <= 1) || (dy > 0 && el.scrollTop >= overY - 1))
          if ((dx === 0 || stuckX) && (dy === 0 || stuckY)) return
          e.preventDefault()
          el.scrollLeft += dx
          el.scrollTop += dy
        },
        { passive: false },
      )
    }

    const blocks = pres.map((pre) => {
      const source = (pre.querySelector('code')?.textContent ?? pre.textContent ?? '').trim()
      const wrap = document.createElement('div')
      wrap.className = 'mermaid-scroll'
      enableWheelPan(wrap)
      pre.replaceWith(wrap)
      return { wrap, source, fallback: pre, failed: false }
    })

    const noMax = { useMaxWidth: false }
    let renderToken = 0
    const renderAll = async () => {
      const token = ++renderToken
      mermaid.initialize({
        startOnLoad: false,
        suppressErrorRendering: true,
        theme: document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'neutral',
        sequence: noMax,
        flowchart: noMax,
        class: noMax,
        state: noMax,
        er: noMax,
        journey: noMax,
        gantt: noMax,
        pie: noMax,
        mindmap: noMax,
        gitGraph: noMax,
      })
      for (const [i, block] of blocks.entries()) {
        if (block.failed) continue
        try {
          const { svg } = await mermaid.render(`mermaid-svg-${i}-${token}`, block.source)
          if (token !== renderToken) return
          block.wrap.innerHTML = svg
        } catch {
          if (token !== renderToken) return
          block.failed = true
          block.wrap.replaceWith(block.fallback)
        }
      }
    }

    await renderAll()

    // 跟随明暗切换用新主题重渲染
    new MutationObserver(() => void renderAll()).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    })
  }

  void setupMermaid()
</script>
