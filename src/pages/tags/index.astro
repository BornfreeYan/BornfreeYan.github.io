---
import Layout from '../../layouts/Layout.astro'
import { getSortedArticles } from '../../lib/articles'

const all = await getSortedArticles()
const counts = new Map<string, number>()
for (const a of all) {
  for (const t of a.data.tags) {
    counts.set(t, (counts.get(t) ?? 0) + 1)
  }
}
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1])
---

<Layout title="Tags">
  <div class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="font-serif text-3xl font-semibold">Tags</h1>
    <p class="mt-2 text-muted">共 {tags.length} 个标签</p>
    <div class="mt-8 flex flex-wrap gap-2.5">
      {
        tags.length > 0 ? (
          tags.map(([name, n]) => (
            <a
              href={`/tags/${encodeURIComponent(name)}`}
              class="group rounded-full border border-line bg-surface px-4 py-2 text-sm text-muted transition-colors hover:border-accent hover:text-accent"
            >
              #{name}
              <span class="ml-1.5 text-xs opacity-70">{n}</span>
            </a>
          ))
        ) : (
          <p class="text-muted">暂无标签</p>
        )
      }
    </div>
  </div>
</Layout>