---
import Layout from '../../layouts/Layout.astro'
import ArticleCard from '../../components/ArticleCard.astro'
import { getSortedArticles } from '../../lib/articles'

export async function getStaticPaths() {
  const all = await getSortedArticles()
  const names = [...new Set(all.flatMap((a) => a.data.categories))]
  return names.map((name) => ({
    params: { name },
    props: { name, articles: all.filter((a) => a.data.categories.includes(name)) },
  }))
}

const { name, articles } = Astro.props
---

<Layout title={name}>
  <div class="mx-auto max-w-5xl px-4 py-16">
    <div class="mb-8">
      <a href="/categories" class="text-sm text-muted transition-colors hover:text-accent">
        ← 全部分类
      </a>
      <h1 class="mt-2 font-serif text-3xl font-semibold">{name}</h1>
      <p class="mt-1 text-sm text-muted">{articles.length} 篇文章</p>
    </div>
    <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
      {articles.map((a) => <ArticleCard article={a} />)}
    </div>
  </div>
</Layout>