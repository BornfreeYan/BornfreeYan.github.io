---
import Layout from '../../layouts/Layout.astro'
import { getSortedArticles } from '../../lib/articles'

const all = await getSortedArticles()
const counts = new Map<string, number>()
for (const a of all) {
  for (const c of a.data.categories) {
    counts.set(c, (counts.get(c) ?? 0) + 1)
  }
}
const cats = [...counts.entries()].sort((a, b) => b[1] - a[1])
---

<Layout title="Categories">
  <div class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="font-serif text-3xl font-semibold">Categories</h1>
    <p class="mt-2 text-muted">共 {cats.length} 个分类</p>
    <div class="mt-8 flex flex-col gap-3">
      {
        cats.length > 0 ? (
          cats.map(([name, n]) => (
            <a
              href={`/categories/${encodeURIComponent(name)}`}
              class="group flex items-center justify-between rounded-xl border border-line bg-surface px-5 py-4 transition-colors hover:border-accent/40"
            >
              <span class="font-medium transition-colors group-hover:text-accent">{name}</span>
              <span class="rounded-full bg-line/60 px-2.5 py-0.5 text-xs text-muted">{n}</span>
            </a>
          ))
        ) : (
          <p class="text-muted">暂无分类</p>
        )
      }
    </div>
  </div>
</Layout>