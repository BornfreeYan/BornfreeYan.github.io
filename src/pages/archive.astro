---
import Layout from '../layouts/Layout.astro'
import { getSortedArticles } from '../lib/articles'
import { formatDate } from '../lib/format'

const all = await getSortedArticles()

const byYear = new Map<number, Map<number, typeof all>>()
for (const a of all) {
  const y = a.data.date.getFullYear()
  const m = a.data.date.getMonth() + 1
  if (!byYear.has(y)) byYear.set(y, new Map())
  const months = byYear.get(y)!
  if (!months.has(m)) months.set(m, [])
  months.get(m)!.push(a)
}
const years = [...byYear.entries()].sort((a, b) => b[0] - a[0])
---

<Layout title="Archive">
  <div class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="font-serif text-3xl font-semibold">Archive</h1>
    <p class="mt-2 text-muted">共 {all.length} 篇文章的时间线。</p>
    <div class="mt-10 space-y-10">
      {
        years.map(([year, months]) => (
          <section>
            <h2 class="flex items-center gap-3 font-serif text-xl font-semibold text-accent">
              {year}
              <span class="h-px flex-1 bg-line"></span>
            </h2>
            <div class="mt-4 space-y-6">
              {[...months.entries()].sort((a, b) => b[0] - a[0]).map(([month, arts]) => (
                <div>
                  <h3 class="mb-2 text-sm font-medium text-muted">{month} 月</h3>
                  <div class="ml-2 flex flex-col gap-2 border-l border-line pl-4">
                    {arts.map((a) => (
                      <a
                        href={`/articles/${a.id}/`}
                        class="group flex items-baseline justify-between gap-4 rounded-lg px-2 py-2 transition-colors hover:bg-line/40"
                      >
                        <span class="group-hover:text-accent">{a.data.title}</span>
                        <time class="shrink-0 text-xs text-muted">{formatDate(a.data.date)}</time>
                      </a>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</Layout>