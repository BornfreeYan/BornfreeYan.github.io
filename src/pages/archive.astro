---
import Layout from '../layouts/Layout.astro'
import { getSortedArticles } from '../lib/articles'
import { formatDate } from '../lib/format'

const all = await getSortedArticles()

const byYear = new Map<number, Map<number, typeof all>>()
for (const a of all) {
  const y = a.data.date.getFullYear()
  const m = a.data.date.getMonth() + 1
  if (!byYear.has(y)) byYear.set(y, new Map())
  const months = byYear.get(y)!
  if (!months.has(m)) months.set(m, [])
  months.get(m)!.push(a)
}
const years = [...byYear.entries()].sort((a, b) => b[0] - a[0])
---

<Layout title="Archive">
  <div class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="font-display text-3xl font-semibold">Archive</h1>
    <p class="mt-2 text-muted">共 {all.length} 篇文章的时间线。</p>
    <div class="mt-12 space-y-14">
      {
        years.map(([year, months]) => (
          <section>
            <h2 class="flex items-center gap-4 font-display text-2xl text-ink">
              {year}
              <span class="h-px flex-1 bg-line"></span>
            </h2>
            <div class="mt-6 space-y-8">
              {[...months.entries()].sort((a, b) => b[0] - a[0]).map(([month, arts]) => (
                <div class="relative pl-8">
                  <span class="absolute left-0 top-1.5 h-2 w-2 rounded-full border border-accent bg-bg"></span>
                  <h3 class="mb-3 text-xs font-medium uppercase tracking-[0.2em] text-muted">
                    {month} 月
                  </h3>
                  <div class="flex flex-col gap-1 border-l border-line pl-5">
                    {arts.map((a) => (
                      <a
                        href={`/articles/${a.id}/`}
                        class="group flex items-baseline justify-between gap-4 py-2 transition-colors"
                      >
                        <span class="transition-colors group-hover:text-accent">{a.data.title}</span>
                        <time class="shrink-0 font-display text-xs text-muted">
                          {formatDate(a.data.date)}
                        </time>
                      </a>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</Layout>