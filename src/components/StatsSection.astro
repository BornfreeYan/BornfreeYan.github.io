---
import { siteConfig } from '../config'

interface Props {
  wordCount: number
}

const { wordCount } = Astro.props
const showUptime = siteConfig.uptimeBadgeUrl !== ''
---

<section class="mx-auto max-w-5xl px-4 pb-24">
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
    <div class="rounded-2xl border border-line bg-surface p-6 text-center">
      <p class="text-3xl font-semibold text-accent" id="busuanzi_value_site_pv">
        —
      </p>
      <p class="mt-1 text-sm text-muted">网站访问量</p>
    </div>
    <div class="rounded-2xl border border-line bg-surface p-6 text-center">
      <p class="text-3xl font-semibold text-accent">{wordCount.toLocaleString()}</p>
      <p class="mt-1 text-sm text-muted">累计字数</p>
    </div>
    <div class="rounded-2xl border border-line bg-surface p-6 text-center">
      {
        showUptime ? (
          <div class="flex h-9 items-center justify-center">
            <img
              src={siteConfig.uptimeBadgeUrl}
              alt="正常运行时间"
              class="max-h-9"
              loading="lazy"
            />
          </div>
        ) : (
          <>
            <p class="text-3xl font-semibold text-accent">—</p>
            <p class="mt-1 text-sm text-muted">正常运行时间</p>
          </>
        )
      }
    </div>
  </div>
  <script src="//busuanzi.ibruce.info/busuanzi?jsonpCallback=BusuanziCallback" async is:inline></script>
</section>