---
import Icon from './Icon.astro'
---

<div data-search-overlay class="fixed inset-0 z-50 hidden">
  <div data-search-close class="absolute inset-0 bg-black/40 backdrop-blur-sm"></div>
  <div class="absolute inset-x-0 top-0 mx-auto max-w-xl px-4 pt-24">
    <div class="rounded-2xl border border-line bg-surface p-4 shadow-2xl">
      <div class="flex items-center gap-2 border-b border-line pb-3">
        <Icon name="search" class="h-5 w-5 shrink-0 text-muted" />
        <input
          data-search-input
          type="search"
          placeholder="搜索文章…"
          autocomplete="off"
          class="w-full bg-transparent text-lg outline-none placeholder:text-muted"
        />
        <button
          data-search-close
          class="shrink-0 rounded-lg p-1 text-muted transition-colors hover:text-ink"
          aria-label="关闭搜索"
        >
          <Icon name="close" class="h-5 w-5" />
        </button>
      </div>
      <div data-search-results class="mt-3 max-h-[55vh] overflow-y-auto"></div>
      <p data-search-hint class="mt-3 text-xs text-muted">搜索索引在构建时生成，预览请先 npm run build</p>
    </div>
  </div>
</div>

<script is:inline>
  let pagefind = null

  const overlay = document.querySelector('[data-search-overlay]')
  const input = document.querySelector('[data-search-input]')
  const results = document.querySelector('[data-search-results]')
  const hint = document.querySelector('[data-search-hint]')

  if (!overlay || !input || !results || !hint) throw new Error('search elements missing')

  async function initPagefind() {
    if (pagefind) return true
    try {
      const modUrl = '/pagefind/pagefind.js'
      pagefind = await import(modUrl)
      hint.textContent = ''
      return true
    } catch {
      hint.textContent = '搜索索引未生成，请先执行 npm run build'
      return false
    }
  }

  function open() {
    overlay.classList.remove('hidden')
    input.value = ''
    results.innerHTML = ''
    setTimeout(() => input.focus(), 50)
    initPagefind()
  }

  function close() {
    overlay.classList.add('hidden')
  }

  document.addEventListener('click', (e) => {
    const target = e.target
    if (target.closest('[data-search-open]')) open()
    else if (target.closest('[data-search-close]')) close()
  })

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      close()
      return
    }
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault()
      open()
    }
  })

  let timer
  input.addEventListener('input', () => {
    clearTimeout(timer)
    timer = setTimeout(runSearch, 200)
  })
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') runSearch()
  })

  async function runSearch() {
    const term = input.value.trim()
    if (!term) {
      results.innerHTML = ''
      return
    }
    const ok = await initPagefind()
    if (!ok) return
    const search = await pagefind.search(term)
    const items = (search.results ?? []).slice(0, 12)
    if (items.length === 0) {
      results.innerHTML = '<p class="p-3 text-sm text-muted">没有找到相关内容</p>'
      return
    }
    const data = await Promise.all(items.map((r) => r.data()))
    results.innerHTML = data
      .map(
        (d) => `
        <a href="${d.url}" class="block rounded-xl px-3 py-3 transition-colors hover:bg-line/60">
          <p class="font-medium">${d.meta?.title ?? ''}</p>
          <p class="mt-1 line-clamp-2 text-sm text-muted">${d.excerpt ?? ''}</p>
        </a>
      `
      )
      .join('')
  }
</script>