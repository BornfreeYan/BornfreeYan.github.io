---
---

<div data-memo-app class="space-y-6">
  <div data-memo-composer></div>
  <p data-memo-error class="hidden rounded-xl border border-red-400/40 bg-red-400/10 p-3 text-sm text-red-500"></p>
  <div data-memo-list class="space-y-4"></div>
  <p data-memo-empty class="hidden rounded-xl border border-dashed border-line p-8 text-center text-sm text-muted">
    还没有 Memo，成为第一条吧。
  </p>
</div>

<script>
  import {
    fetchMemos,
    postMemo,
    deleteMemo,
    getToken,
    setToken,
    memoImageUrl,
    type Memo,
  } from '../lib/memo'
  import { siteConfig } from '../config'

  const MAX_IMAGES = 4

  const app = document.querySelector<HTMLElement>('[data-memo-app]')
  if (!app) throw new Error('memo app element missing')
  const composerBox = document.querySelector<HTMLElement>('[data-memo-composer]')!
  const listBox = document.querySelector<HTMLElement>('[data-memo-list]')!
  const emptyBox = document.querySelector<HTMLElement>('[data-memo-empty]')!
  const errorBox = document.querySelector<HTMLElement>('[data-memo-error]')!

  let memos: Memo[] = []
  let pendingImages: File[] = []

  function esc(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
  }

  function showError(msg: string) {
    errorBox.textContent = msg
    errorBox.classList.remove('hidden')
  }

  function clearError() {
    errorBox.classList.add('hidden')
    errorBox.textContent = ''
  }

  function formatTime(iso: string): string {
    const d = new Date(iso)
    const diff = Date.now() - d.getTime()
    const min = Math.floor(diff / 60000)
    if (min < 1) return '刚刚'
    if (min < 60) return `${min} 分钟前`
    const hour = Math.floor(min / 60)
    if (hour < 24) return `${hour} 小时前`
    const day = Math.floor(hour / 24)
    if (day < 7) return `${day} 天前`
    return d.toLocaleString('zh-CN', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
    })
  }

  function renderComposer() {
    if (getToken()) {
      composerBox.innerHTML = `
        <div class="rounded-2xl border border-line bg-surface p-4">
          <textarea data-composer-text rows="3" placeholder="写点什么…" class="w-full resize-none bg-transparent text-sm leading-relaxed outline-none placeholder:text-muted"></textarea>
          <div data-composer-preview class="mt-3 flex flex-wrap gap-2"></div>
          <div class="mt-3 flex items-center justify-between gap-3">
            <div class="flex items-center gap-2">
              <button data-attach type="button" class="flex items-center gap-1.5 rounded-lg border border-line px-3 py-1.5 text-xs text-muted transition-colors hover:border-accent hover:text-accent">📷 图片 (最多 4 张)</button>
              <input data-file-input type="file" accept="image/*" multiple class="hidden">
              <button data-logout type="button" class="rounded-lg px-3 py-1.5 text-xs text-muted transition-colors hover:text-red-500">断开</button>
            </div>
            <button data-submit type="button" class="rounded-lg bg-accent px-5 py-1.5 text-sm text-bg transition-opacity hover:opacity-90">发布</button>
          </div>
        </div>`
    } else {
      composerBox.innerHTML = `
        <div class="rounded-2xl border border-dashed border-line bg-surface p-5">
          <p class="text-sm text-muted">发 Memo 需要连接 GitHub 数据仓库 <code class="rounded bg-line/60 px-1.5 py-0.5 text-xs">${esc(siteConfig.memoRepo)}</code>。Token 仅保存在本浏览器，请用只有该仓库读写权限的 fine-grained token。</p>
          <div class="mt-4 flex flex-col gap-2 sm:flex-row">
            <input data-token-input type="password" placeholder="粘贴 fine-grained token" autocomplete="off" class="flex-1 rounded-lg border border-line bg-transparent px-3 py-2 text-sm outline-none placeholder:text-muted focus:border-accent">
            <button data-token-save type="button" class="rounded-lg bg-accent px-5 py-2 text-sm text-bg transition-opacity hover:opacity-90">连接</button>
          </div>
        </div>`
    }

    composerBox.querySelector('[data-attach]')?.addEventListener('click', () => {
      composerBox.querySelector<HTMLInputElement>('[data-file-input]')?.click()
    })
    composerBox.querySelector<HTMLInputElement>('[data-file-input]')?.addEventListener('change', (e) => {
      const input = e.target as HTMLInputElement
      const files = Array.from(input.files ?? [])
      pendingImages = [...pendingImages, ...files].slice(0, MAX_IMAGES)
      input.value = ''
      renderPreview()
    })
    composerBox.querySelector('[data-logout]')?.addEventListener('click', () => {
      const c = confirm('确定断开？本地 token 将被清除。')
      if (!c) return
      localStorage.removeItem('bfy_memo_token')
      pendingImages = []
      renderComposer()
    })
    composerBox.querySelector('[data-token-save]')?.addEventListener('click', () => {
      const input = composerBox.querySelector<HTMLInputElement>('[data-token-input]')
      const token = input?.value.trim() ?? ''
      if (!token) return
      setToken(token)
      renderComposer()
      load()
    })
    composerBox.querySelector('[data-submit]')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement
      const textarea = composerBox.querySelector<HTMLTextAreaElement>('[data-composer-text]')
      const text = textarea?.value ?? ''
      if (!text.trim() && pendingImages.length === 0) return
      btn.disabled = true
      btn.textContent = '发布中…'
      clearError()
      try {
        await postMemo(text, pendingImages)
        textarea!.value = ''
        pendingImages = []
        renderPreview()
        await load()
      } catch (err) {
        showError(err instanceof Error ? err.message : '发布失败，请重试')
      } finally {
        btn.disabled = false
        btn.textContent = '发布'
      }
    })
  }

  function renderPreview() {
    const preview = composerBox.querySelector<HTMLElement>('[data-composer-preview]')
    if (!preview) return
    if (pendingImages.length === 0) {
      preview.innerHTML = ''
      return
    }
    preview.innerHTML = pendingImages
      .map((f, i) => {
        const url = URL.createObjectURL(f)
        return `<div class="relative">
          <img src="${url}" class="h-20 w-20 rounded-lg border border-line object-cover">
          <button data-remove-img="${i}" type="button" class="absolute -right-1.5 -top-1.5 flex h-5 w-5 items-center justify-center rounded-full bg-red-500 text-xs text-white">×</button>
        </div>`
      })
      .join('')
    preview.querySelectorAll<HTMLButtonElement>('[data-remove-img]').forEach((btn) => {
      btn.addEventListener('click', () => {
        pendingImages = pendingImages.filter((_, i) => i !== Number(btn.dataset.removeImg))
        renderPreview()
      })
    })
  }

  function renderList() {
    if (memos.length === 0) {
      emptyBox.classList.remove('hidden')
      listBox.innerHTML = ''
      return
    }
    emptyBox.classList.add('hidden')
    listBox.innerHTML = memos
      .map(
        (m) => `
        <div class="rounded-2xl border border-line bg-surface p-5">
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-accent/15 font-serif text-lg text-accent">B</div>
            <div class="min-w-0">
              <p class="text-sm font-semibold">${esc(siteConfig.author)}</p>
              <p class="text-xs text-muted">${esc(formatTime(m.createdAt))}</p>
            </div>
            ${getToken() ? `<button data-delete="${m.id}" type="button" class="ml-auto rounded-lg px-2 py-1 text-muted transition-colors hover:text-red-500" title="删除">🗑</button>` : ''}
          </div>
          ${m.text ? `<p class="mt-3 whitespace-pre-wrap text-sm leading-relaxed">${esc(m.text)}</p>` : ''}
          ${renderImages(m.images)}
        </div>`
      )
      .join('')

    listBox.querySelectorAll<HTMLButtonElement>('[data-delete]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (!confirm('确定删除这条 Memo？')) return
        clearError()
        try {
          await deleteMemo(btn.dataset.delete ?? '')
          await load()
        } catch (err) {
          showError(err instanceof Error ? err.message : '删除失败')
        }
      })
    })
  }

  function renderImages(images: string[]): string {
    if (images.length === 0) return ''
    const cols = images.length === 1 ? 'grid-cols-1' : 'grid-cols-2'
    return `<div class="mt-3 grid ${cols} gap-2">
      ${images
        .map(
          (p) =>
            `<img src="${esc(memoImageUrl(p))}" loading="lazy" class="w-full rounded-xl border border-line object-cover" style="max-height:24rem">`
        )
        .join('')}
    </div>`
  }

  async function load() {
    clearError()
    listBox.innerHTML = `<p class="p-4 text-center text-sm text-muted">加载中…</p>`
    try {
      memos = await fetchMemos()
    } catch {
      memos = []
    }
    renderList()
  }

  renderComposer()
  load()
</script>