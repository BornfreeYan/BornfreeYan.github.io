---
---

<div data-memo-app class="space-y-5">
  <div data-memo-auth class="relative flex justify-end"></div>
  <div data-memo-composer></div>
  <p data-memo-error class="hidden rounded-xl border border-red-400/40 bg-red-400/10 p-3 text-sm text-red-500"></p>
  <div data-memo-list class="space-y-4"></div>
  <p data-memo-empty class="hidden rounded-xl border border-dashed border-line p-8 text-center text-sm text-muted">
    还没有 Memo，成为第一条吧。
  </p>
</div>

<div
  data-lightbox
  class="fixed inset-0 z-[70] hidden items-center justify-center bg-bg/95 backdrop-blur-sm p-4"
  aria-hidden="true"
>
  <button
    data-lightbox-close
    type="button"
    class="absolute right-4 top-4 rounded-full p-2 text-ink transition-colors hover:text-accent"
    aria-label="关闭"
  >
    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18"/><path d="M6 6l12 12"/></svg>
  </button>
  <button
    data-lightbox-prev
    type="button"
    class="absolute left-4 top-1/2 -translate-y-1/2 rounded-full p-2 text-ink transition-colors hover:text-accent"
    aria-label="上一张"
  >
    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
  </button>
  <button
    data-lightbox-next
    type="button"
    class="absolute right-4 top-1/2 -translate-y-1/2 rounded-full p-2 text-ink transition-colors hover:text-accent"
    aria-label="下一张"
  >
    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
  </button>
  <img data-lightbox-img class="max-h-[90vh] max-w-[90vw] rounded-xl object-contain" src="" alt="" />
  <div data-lightbox-counter class="absolute bottom-4 left-1/2 -translate-x-1/2 text-sm text-muted"></div>
</div>

<script>
  import {
    fetchMemos,
    postMemo,
    deleteMemo,
    getToken,
    setToken,
    validateToken,
    memoImageUrl,
    type Memo,
  } from '../lib/memo'
  import { siteConfig } from '../config'
  import { formatMemoDate } from '../lib/format'

  const MAX_IMAGES = 6

  const TRASH_SVG = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>`
  const REPLY_SVG = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5"><path d="M9 17l-5-5 5-5"/><path d="M20 18v-2a4 4 0 0 0-4-4H4"/></svg>`

  const app = document.querySelector<HTMLElement>('[data-memo-app]')
  if (!app) throw new Error('memo app element missing')
  const authBox = document.querySelector<HTMLElement>('[data-memo-auth]')!
  const composerBox = document.querySelector<HTMLElement>('[data-memo-composer]')!
  const listBox = document.querySelector<HTMLElement>('[data-memo-list]')!
  const emptyBox = document.querySelector<HTMLElement>('[data-memo-empty]')!
  const errorBox = document.querySelector<HTMLElement>('[data-memo-error]')!

  let memos: Memo[] = []
  let pendingImages: File[] = []
  let pendingExternalImages: string[] = []
  let pendingReply: Memo | null = null

  let lightboxImages: string[] = []
  let lightboxIndex = 0

  function esc(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
  }

  function showError(msg: string) {
    errorBox.textContent = msg
    errorBox.classList.remove('hidden')
  }

  function clearError() {
    errorBox.classList.add('hidden')
    errorBox.textContent = ''
  }

  function isImageUrl(s: string): boolean {
    return /^https?:\/\//.test(s.trim())
  }

  function renderAuth() {
    if (getToken()) {
      authBox.innerHTML = `<button data-logout type="button" class="flex items-center gap-1.5 rounded-full border border-line px-3.5 py-1.5 text-xs text-muted transition-colors hover:border-red-500 hover:text-red-500">
        <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>已连接 · 断开
      </button>`
    } else {
      authBox.innerHTML = `
        <button data-auth-toggle type="button" class="rounded-full border border-line px-3.5 py-1.5 text-xs text-muted transition-colors hover:border-accent hover:text-accent">连接</button>
        <div data-auth-panel class="absolute right-0 top-full z-10 mt-2 hidden w-72 rounded-xl border border-line bg-surface p-4 shadow-lg">
          <p class="text-xs text-muted">粘贴 GitHub fine-grained token（仅保存在本浏览器）</p>
          <input data-token-input type="password" placeholder="github_pat_…" autocomplete="off" class="mt-2 w-full rounded-lg border border-line bg-transparent px-3 py-2 text-sm outline-none placeholder:text-muted focus:border-accent">
          <p data-token-error class="mt-2 hidden text-xs text-red-500"></p>
          <div class="mt-3 flex justify-end gap-2">
            <button data-auth-cancel type="button" class="rounded-lg px-3 py-1.5 text-xs text-muted transition-colors hover:text-ink">取消</button>
            <button data-token-save type="button" class="rounded-lg bg-accent px-4 py-1.5 text-xs text-bg transition-opacity hover:opacity-90">连接</button>
          </div>
        </div>`
    }
    bindAuth()
  }

  function bindAuth() {
    const panel = authBox.querySelector<HTMLElement>('[data-auth-panel]')
    const tokenError = authBox.querySelector<HTMLElement>('[data-token-error]')

    authBox.querySelector('[data-auth-toggle]')?.addEventListener('click', () => {
      panel?.classList.toggle('hidden')
      if (tokenError) tokenError.classList.add('hidden')
    })
    authBox.querySelector('[data-auth-cancel]')?.addEventListener('click', () => {
      panel?.classList.add('hidden')
      if (tokenError) tokenError.classList.add('hidden')
    })
    authBox.querySelector('[data-logout]')?.addEventListener('click', () => {
      const c = confirm('确定断开？本地 token 将被清除。')
      if (!c) return
      localStorage.removeItem('bfy_memo_token')
      pendingImages = []
      pendingExternalImages = []
      pendingReply = null
      renderAuth()
      renderComposer()
    })
    authBox.querySelector('[data-token-save]')?.addEventListener('click', async () => {
      const input = authBox.querySelector<HTMLInputElement>('[data-token-input]')
      const btn = authBox.querySelector<HTMLButtonElement>('[data-token-save]')
      const token = input?.value.trim() ?? ''
      if (!token) return
      btn!.disabled = true
      btn!.textContent = '验证中…'
      const res = await validateToken(token)
      if (!res.ok) {
        if (tokenError) {
          tokenError.textContent = res.message ?? '连接失败'
          tokenError.classList.remove('hidden')
        }
        btn!.disabled = false
        btn!.textContent = '连接'
        return
      }
      setToken(token)
      renderAuth()
      renderComposer()
      load()
    })
  }

  function renderComposer() {
    if (!getToken()) {
      composerBox.innerHTML = ''
      return
    }
    composerBox.innerHTML = `
      <div class="rounded-2xl border border-line bg-surface p-4">
        ${
          pendingReply
            ? `<div data-reply-chip class="mb-3 flex items-center gap-2 rounded-lg border-l-2 border-accent bg-line/40 px-3 py-2 text-xs">
                <span class="font-medium text-accent">引用 ${esc(formatMemoDate(pendingReply.createdAt))} 的 memo</span>
                <span class="line-clamp-1 flex-1 text-muted">${esc(pendingReply.text || '（图片）')}</span>
                <button data-reply-clear type="button" class="shrink-0 text-muted transition-colors hover:text-red-500" title="取消引用">×</button>
              </div>`
            : ''
        }
        <textarea data-composer-text rows="3" placeholder="写点什么…" class="w-full resize-none bg-transparent text-sm leading-relaxed outline-none placeholder:text-muted"></textarea>
        <div data-composer-preview class="mt-3 flex flex-wrap gap-2"></div>
        <div data-url-input-area class="hidden mt-3 flex items-center gap-2">
          <input data-url-input type="text" placeholder="https://你的图床.com/xxx.png" class="min-w-0 flex-1 rounded-lg border border-line bg-transparent px-3 py-2 text-sm outline-none placeholder:text-muted focus:border-accent">
          <button data-url-add type="button" class="rounded-lg bg-accent px-3 py-2 text-xs text-bg transition-opacity hover:opacity-90">添加</button>
          <button data-url-cancel type="button" class="rounded-lg px-3 py-2 text-xs text-muted transition-colors hover:text-ink">取消</button>
        </div>
        <div class="mt-3 flex items-center justify-between gap-3">
          <div class="flex items-center gap-2">
            <button data-attach type="button" class="flex items-center gap-1.5 rounded-lg border border-line px-3 py-1.5 text-xs text-muted transition-colors hover:border-accent hover:text-accent">📷 本地上传</button>
            <button data-attach-url type="button" class="flex items-center gap-1.5 rounded-lg border border-line px-3 py-1.5 text-xs text-muted transition-colors hover:border-accent hover:text-accent">🔗 图床链接</button>
            <input data-file-input type="file" accept="image/*" multiple class="hidden">
          </div>
          <button data-submit type="button" class="rounded-lg bg-accent px-5 py-1.5 text-sm text-bg transition-opacity hover:opacity-90">发布</button>
        </div>
      </div>`
    bindComposer()
  }

  function bindComposer() {
    composerBox.querySelector('[data-attach]')?.addEventListener('click', () => {
      composerBox.querySelector<HTMLInputElement>('[data-file-input]')?.click()
    })
    composerBox.querySelector<HTMLInputElement>('[data-file-input]')?.addEventListener('change', (e) => {
      const input = e.target as HTMLInputElement
      const files = Array.from(input.files ?? [])
      const total = pendingImages.length + pendingExternalImages.length + files.length
      if (total > MAX_IMAGES) {
        showError(`最多 ${MAX_IMAGES} 张图片`)
        input.value = ''
        return
      }
      pendingImages = [...pendingImages, ...files].slice(0, MAX_IMAGES)
      input.value = ''
      renderPreview()
    })
    composerBox.querySelector('[data-attach-url]')?.addEventListener('click', () => {
      const area = composerBox.querySelector<HTMLElement>('[data-url-input-area]')
      area?.classList.remove('hidden')
      composerBox.querySelector<HTMLInputElement>('[data-url-input]')?.focus()
    })
    composerBox.querySelector('[data-url-cancel]')?.addEventListener('click', () => {
      const area = composerBox.querySelector<HTMLElement>('[data-url-input-area]')
      const input = composerBox.querySelector<HTMLInputElement>('[data-url-input]')
      area?.classList.add('hidden')
      if (input) input.value = ''
    })
    composerBox.querySelector('[data-url-add]')?.addEventListener('click', () => {
      const input = composerBox.querySelector<HTMLInputElement>('[data-url-input]')
      const area = composerBox.querySelector<HTMLElement>('[data-url-input-area]')
      const url = input?.value.trim() ?? ''
      if (!url) return
      if (!isImageUrl(url)) {
        showError('请输入以 http:// 或 https:// 开头的图片链接')
        return
      }
      const total = pendingImages.length + pendingExternalImages.length + 1
      if (total > MAX_IMAGES) {
        showError(`最多 ${MAX_IMAGES} 张图片`)
        return
      }
      pendingExternalImages.push(url)
      if (input) input.value = ''
      area?.classList.add('hidden')
      renderPreview()
    })
    composerBox.querySelector('[data-reply-clear]')?.addEventListener('click', () => {
      pendingReply = null
      renderComposer()
      renderPreview()
    })
    composerBox.querySelector('[data-submit]')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement
      const textarea = composerBox.querySelector<HTMLTextAreaElement>('[data-composer-text]')
      const text = textarea?.value ?? ''
      if (!text.trim() && pendingImages.length === 0 && pendingExternalImages.length === 0) return
      btn.disabled = true
      btn.textContent = '发布中…'
      clearError()
      try {
        await postMemo(text, pendingImages, pendingExternalImages, pendingReply?.id)
        textarea!.value = ''
        pendingImages = []
        pendingExternalImages = []
        pendingReply = null
        renderComposer()
        renderPreview()
        await load()
      } catch (err) {
        showError(err instanceof Error ? err.message : '发布失败，请重试')
      } finally {
        btn.disabled = false
        btn.textContent = '发布'
      }
    })
  }

  function renderPreview() {
    const preview = composerBox.querySelector<HTMLElement>('[data-composer-preview]')
    if (!preview) return
    const total = pendingImages.length + pendingExternalImages.length
    if (total === 0) {
      preview.innerHTML = ''
      return
    }

    const fileItems = pendingImages
      .map((f, i) => {
        const url = URL.createObjectURL(f)
        return `<div class="relative">
          <img src="${url}" class="h-20 w-20 rounded-lg border border-line object-cover">
          <button data-remove-img="${i}" type="button" class="absolute -right-1.5 -top-1.5 flex h-5 w-5 items-center justify-center rounded-full bg-red-500 text-xs text-white">×</button>
        </div>`
      })

    const urlItems = pendingExternalImages
      .map((url, i) => {
        return `<div class="relative">
          <img src="${esc(url)}" class="h-20 w-20 rounded-lg border border-line object-cover">
          <button data-remove-url="${i}" type="button" class="absolute -right-1.5 -top-1.5 flex h-5 w-5 items-center justify-center rounded-full bg-red-500 text-xs text-white">×</button>
        </div>`
      })

    preview.innerHTML = [...fileItems, ...urlItems].join('')

    preview.querySelectorAll<HTMLButtonElement>('[data-remove-img]').forEach((btn) => {
      btn.addEventListener('click', () => {
        pendingImages = pendingImages.filter((_, i) => i !== Number(btn.dataset.removeImg))
        renderPreview()
      })
    })
    preview.querySelectorAll<HTMLButtonElement>('[data-remove-url]').forEach((btn) => {
      btn.addEventListener('click', () => {
        pendingExternalImages = pendingExternalImages.filter((_, i) => i !== Number(btn.dataset.removeUrl))
        renderPreview()
      })
    })
  }

  function renderAvatar(): string {
    if (siteConfig.avatar) {
      return `<img src="${esc(siteConfig.avatar)}" alt="${esc(siteConfig.author)}" class="h-10 w-10 shrink-0 rounded-full object-cover" />`
    }
    return `<div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-accent/15 font-serif text-lg text-accent">${esc(siteConfig.author.charAt(0).toUpperCase())}</div>`
  }

  function renderList() {
    if (memos.length === 0) {
      emptyBox.classList.remove('hidden')
      listBox.innerHTML = ''
      return
    }
    emptyBox.classList.add('hidden')
    listBox.innerHTML = memos
      .map(
        (m) => `
        <div data-memo-id="${m.id}" class="rounded-2xl border border-line bg-surface p-5">
          <div class="flex items-center gap-3">
            ${renderAvatar()}
            <div class="min-w-0">
              <p class="text-sm font-semibold">${esc(siteConfig.author)}</p>
              <p class="text-xs text-muted">${esc(formatMemoDate(m.createdAt))}</p>
            </div>
            <div class="ml-auto flex items-center gap-1">
              ${
                getToken()
                  ? `<button data-reply="${m.id}" type="button" class="flex h-7 w-7 items-center justify-center rounded-full text-muted transition-colors hover:bg-line/60 hover:text-accent" title="引用">${REPLY_SVG}</button>
                  <button data-delete="${m.id}" type="button" class="flex h-7 w-7 items-center justify-center rounded-full text-muted transition-colors hover:bg-red-500/10 hover:text-red-500" title="删除">${TRASH_SVG}</button>`
                  : ''
              }
            </div>
          </div>
          ${m.replyTo ? renderQuote(m) : ''}
          ${m.text ? `<p class="mt-3 whitespace-pre-wrap text-sm leading-relaxed">${esc(m.text)}</p>` : ''}
          ${renderImages(m.images)}
        </div>`
      )
      .join('')
    bindList()
  }

  function renderQuote(m: Memo): string {
    const target = memos.find((x) => x.id === m.replyTo)
    const date = target ? formatMemoDate(target.createdAt) : ''
    const snippet = (target?.text || '（已删除的 memo）').slice(0, 80)
    return `<div data-jump="${m.replyTo}" class="mt-3 flex cursor-pointer items-center gap-2 rounded-lg border-l-2 border-accent/40 bg-line/40 px-3 py-2 text-xs text-muted transition-colors hover:text-accent">
      <span class="shrink-0 font-medium">${esc(date ? `引用 · ${date}` : '引用')}</span>
      <span class="line-clamp-1 flex-1">${esc(snippet)}</span>
    </div>`
  }

  function renderImages(images: string[]): string {
    if (images.length === 0) return ''
    const cols = images.length === 1 ? 'grid-cols-1' : 'grid-cols-2'
    return `<div class="mt-3 grid ${cols} gap-2">
      ${images
        .map(
          (p, i) => {
            const url = esc(memoImageUrl(p))
            return `<a href="${url}" data-lightbox-open data-lightbox-index="${i}" data-lightbox-url="${url}" class="block overflow-hidden rounded-xl border border-line bg-line/30 transition-opacity hover:opacity-95">
              <img src="${url}" loading="lazy" class="w-full object-contain" style="max-height:24rem">
            </a>`
          }
        )
        .join('')}
    </div>`
  }

  const lightbox = document.querySelector<HTMLElement>('[data-lightbox]')
  const lightboxImg = document.querySelector<HTMLImageElement>('[data-lightbox-img]')
  const lightboxCounter = document.querySelector<HTMLElement>('[data-lightbox-counter]')

  function openLightbox(urls: string[], index: number) {
    lightboxImages = urls
    lightboxIndex = Math.max(0, Math.min(index, urls.length - 1))
    updateLightbox()
    lightbox?.classList.remove('hidden')
    lightbox?.classList.add('flex')
    lightbox?.setAttribute('aria-hidden', 'false')
    document.body.style.overflow = 'hidden'
  }

  function closeLightbox() {
    lightbox?.classList.add('hidden')
    lightbox?.classList.remove('flex')
    lightbox?.setAttribute('aria-hidden', 'true')
    document.body.style.overflow = ''
  }

  function updateLightbox() {
    if (lightboxImg) lightboxImg.src = lightboxImages[lightboxIndex]
    if (lightboxCounter) lightboxCounter.textContent = `${lightboxIndex + 1} / ${lightboxImages.length}`
  }

  function showPrev() {
    if (lightboxImages.length <= 1) return
    lightboxIndex = (lightboxIndex - 1 + lightboxImages.length) % lightboxImages.length
    updateLightbox()
  }

  function showNext() {
    if (lightboxImages.length <= 1) return
    lightboxIndex = (lightboxIndex + 1) % lightboxImages.length
    updateLightbox()
  }

  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox()
  })
  document.querySelector('[data-lightbox-close]')?.addEventListener('click', closeLightbox)
  document.querySelector('[data-lightbox-prev]')?.addEventListener('click', (e) => {
    e.stopPropagation()
    showPrev()
  })
  document.querySelector('[data-lightbox-next]')?.addEventListener('click', (e) => {
    e.stopPropagation()
    showNext()
  })
  document.addEventListener('keydown', (e) => {
    if (!lightbox || lightbox.classList.contains('hidden')) return
    if (e.key === 'Escape') closeLightbox()
    if (e.key === 'ArrowLeft') showPrev()
    if (e.key === 'ArrowRight') showNext()
  })

  function bindList() {
    listBox.querySelectorAll<HTMLButtonElement>('[data-delete]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (!confirm('确定删除这条 Memo？')) return
        clearError()
        try {
          await deleteMemo(btn.dataset.delete ?? '')
          await load()
        } catch (err) {
          showError(err instanceof Error ? err.message : '删除失败')
        }
      })
    })
    listBox.querySelectorAll<HTMLButtonElement>('[data-reply]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const m = memos.find((x) => x.id === btn.dataset.reply)
        if (!m) return
        pendingReply = m
        renderComposer()
        renderPreview()
        composerBox.querySelector<HTMLTextAreaElement>('[data-composer-text]')?.focus()
      })
    })
    listBox.querySelectorAll<HTMLElement>('[data-jump]').forEach((el) => {
      el.addEventListener('click', () => {
        const id = el.getAttribute('data-jump')
        if (!id) return
        const target = listBox.querySelector<HTMLElement>(`[data-memo-id="${id}"]`)
        if (!target) return
        target.scrollIntoView({ behavior: 'smooth', block: 'center' })
        target.classList.add('ring-2', 'ring-accent')
        setTimeout(() => target.classList.remove('ring-2', 'ring-accent'), 2000)
      })
    })

    listBox.querySelectorAll<HTMLElement>('[data-lightbox-open]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault()
        const card = el.closest('[data-memo-id]')
        const urls = Array.from(card?.querySelectorAll<HTMLElement>('[data-lightbox-url]') ?? [])
          .map((a) => a.dataset.lightboxUrl ?? '')
          .filter(Boolean)
        const index = Number(el.dataset.lightboxIndex)
        openLightbox(urls, index)
      })
    })
  }

  async function load() {
    clearError()
    listBox.innerHTML = `<p class="p-4 text-center text-sm text-muted">加载中…</p>`
    try {
      memos = await fetchMemos()
    } catch {
      memos = []
    }
    renderList()
  }

  renderAuth()
  renderComposer()
  load()
</script>
