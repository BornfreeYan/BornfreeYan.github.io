---
---

<div data-memo-app class="space-y-5">
  <div data-memo-auth class="relative flex justify-end"></div>
  <div data-memo-composer></div>
  <input
    data-memo-search
    type="search"
    placeholder="搜索 Memo（正文 / 标签）…"
    autocomplete="off"
    class="w-full rounded-xl border border-line bg-surface px-4 py-2.5 text-sm outline-none placeholder:text-muted focus:border-accent"
  />
  <div data-memo-status class="hidden flex flex-wrap items-center gap-2 text-xs text-muted"></div>
  <p data-memo-error class="hidden rounded-xl border border-red-400/40 bg-red-400/10 p-3 text-sm text-red-500"></p>
  <div data-memo-list class="space-y-4"></div>
  <p data-memo-empty class="hidden rounded-xl border border-dashed border-line p-8 text-center text-sm text-muted">
    还没有 Memo，成为第一条吧。
  </p>
</div>

<div
  data-lightbox
  class="fixed inset-0 z-[70] hidden items-center justify-center bg-bg/95 backdrop-blur-sm p-4"
  aria-hidden="true"
>
  <button
    data-lightbox-close
    type="button"
    class="absolute right-4 top-4 rounded-full p-2 text-ink transition-colors hover:text-accent"
    aria-label="关闭"
  >
    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18"/><path d="M6 6l12 12"/></svg>
  </button>
  <button
    data-lightbox-prev
    type="button"
    class="absolute left-4 top-1/2 -translate-y-1/2 rounded-full p-2 text-ink transition-colors hover:text-accent"
    aria-label="上一张"
  >
    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
  </button>
  <button
    data-lightbox-next
    type="button"
    class="absolute right-4 top-1/2 -translate-y-1/2 rounded-full p-2 text-ink transition-colors hover:text-accent"
    aria-label="下一张"
  >
    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
  </button>
  <img data-lightbox-img class="max-h-[90vh] max-w-[90vw] rounded-xl object-contain" src="" alt="" />
  <div data-lightbox-counter class="absolute bottom-4 left-1/2 -translate-x-1/2 text-sm text-muted"></div>
</div>

<script>
  import {
    fetchMemos,
    postMemo,
    deleteMemo,
    getToken,
    setToken,
    validateToken,
    memoImageUrl,
    type Memo,
  } from '../lib/memo'
  import { siteConfig } from '../config'
  import { formatMemoDate, escapeHtml } from '../lib/format'

  const MAX_LOCAL_IMAGES = 4
  const MAX_EXTERNAL_IMAGES = 20
  const MAX_SUGGESTIONS = 8

  // #标签 渲染与输入共用;前导 / 或 ASCII 单词字符时不算标签(避开 URL 片段)
  const TAG_RE = /(?<![/\w])#([\p{L}\p{N}_-]+)/gu
  const TAG_CARET_RE = /(?<![/\w])#([\p{L}\p{N}_-]*)$/u

  const TRASH_SVG = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>`
  const REPLY_SVG = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5"><path d="M9 17l-5-5 5-5"/><path d="M20 18v-2a4 4 0 0 0-4-4H4"/></svg>`

  const app = document.querySelector<HTMLElement>('[data-memo-app]')
  if (!app) throw new Error('memo app element missing')
  const authBox = document.querySelector<HTMLElement>('[data-memo-auth]')!
  const composerBox = document.querySelector<HTMLElement>('[data-memo-composer]')!
  const listBox = document.querySelector<HTMLElement>('[data-memo-list]')!
  const emptyBox = document.querySelector<HTMLElement>('[data-memo-empty]')!
  const errorBox = document.querySelector<HTMLElement>('[data-memo-error]')!
  const searchBox = document.querySelector<HTMLInputElement>('[data-memo-search]')!
  const statusBox = document.querySelector<HTMLElement>('[data-memo-status]')!

  type ViewMemo = Memo & { _tags?: string[] }

  let memos: ViewMemo[] = []
  let pendingImages: File[] = []
  let pendingExternalImages: string[] = []
  let pendingReply: Memo | null = null
  let composerText = ''
  let composerFullscreen = false
  const expandedText = new Set<string>()
  const expandedImages = new Set<string>()

  let tagVocab: string[] = []
  let activeTag: string | null = null
  let searchQuery = ''

  let suggestOpen = false
  let suggestIndex = 0
  let suggestList: string[] = []
  let suggestTokenStart = 0
  let suggestCaret = 0

  let lightboxImages: string[] = []
  let lightboxIndex = 0

  function showError(msg: string) {
    errorBox.textContent = msg
    errorBox.classList.remove('hidden')
  }

  function clearError() {
    errorBox.classList.add('hidden')
    errorBox.textContent = ''
  }

  function isImageUrl(s: string): boolean {
    return /^https?:\/\//.test(s.trim())
  }

  function renderAuth() {
    if (getToken()) {
      authBox.innerHTML = `<button data-logout type="button" class="flex items-center gap-1.5 rounded-full border border-line px-3.5 py-1.5 text-xs text-muted transition-colors hover:border-red-500 hover:text-red-500">
        <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>已连接 · 断开
      </button>`
    } else {
      authBox.innerHTML = `
        <button data-auth-toggle type="button" class="rounded-full border border-line px-3.5 py-1.5 text-xs text-muted transition-colors hover:border-accent hover:text-accent">连接</button>
        <div data-auth-panel class="absolute right-0 top-full z-10 mt-2 hidden w-72 rounded-xl border border-line bg-surface p-4 shadow-lg">
          <p class="text-xs text-muted">粘贴 GitHub fine-grained token（仅保存在本浏览器）</p>
          <input data-token-input type="password" placeholder="github_pat_…" autocomplete="off" class="mt-2 w-full rounded-lg border border-line bg-transparent px-3 py-2 text-sm outline-none placeholder:text-muted focus:border-accent">
          <p data-token-error class="mt-2 hidden text-xs text-red-500"></p>
          <div class="mt-3 flex justify-end gap-2">
            <button data-auth-cancel type="button" class="rounded-lg px-3 py-1.5 text-xs text-muted transition-colors hover:text-ink">取消</button>
            <button data-token-save type="button" class="rounded-lg bg-accent px-4 py-1.5 text-xs text-bg transition-opacity hover:opacity-90">连接</button>
          </div>
        </div>`
    }
    bindAuth()
  }

  function bindAuth() {
    const panel = authBox.querySelector<HTMLElement>('[data-auth-panel]')
    const tokenError = authBox.querySelector<HTMLElement>('[data-token-error]')

    authBox.querySelector('[data-auth-toggle]')?.addEventListener('click', () => {
      panel?.classList.toggle('hidden')
      if (tokenError) tokenError.classList.add('hidden')
    })
    authBox.querySelector('[data-auth-cancel]')?.addEventListener('click', () => {
      panel?.classList.add('hidden')
      if (tokenError) tokenError.classList.add('hidden')
    })
    authBox.querySelector('[data-logout]')?.addEventListener('click', () => {
      const c = confirm('确定断开？本地 token 将被清除。')
      if (!c) return
      localStorage.removeItem('bfy_memo_token')
      pendingImages = []
      pendingExternalImages = []
      pendingReply = null
      composerFullscreen = false
      document.body.style.overflow = ''
      renderAuth()
      renderComposer()
    })
    authBox.querySelector('[data-token-save]')?.addEventListener('click', async () => {
      const input = authBox.querySelector<HTMLInputElement>('[data-token-input]')
      const btn = authBox.querySelector<HTMLButtonElement>('[data-token-save]')
      const token = input?.value.trim() ?? ''
      if (!token) return
      btn!.disabled = true
      btn!.textContent = '验证中…'
      const res = await validateToken(token)
      if (!res.ok) {
        if (tokenError) {
          tokenError.textContent = res.message ?? '连接失败'
          tokenError.classList.remove('hidden')
        }
        btn!.disabled = false
        btn!.textContent = '连接'
        return
      }
      setToken(token)
      renderAuth()
      renderComposer()
      load()
    })
  }

  function renderComposer() {
    if (!getToken()) {
      composerBox.innerHTML = ''
      return
    }
    composerBox.innerHTML = `
      <div
        data-composer-card
        class="${
          composerFullscreen
            ? 'fixed inset-0 z-[60] flex flex-col bg-bg p-5 md:p-10'
            : 'rounded-2xl border border-line bg-surface p-4'
        }"
      >
        ${
          composerFullscreen
            ? `<button data-composer-close type="button" class="absolute right-4 top-4 rounded-full p-2 text-muted transition-colors hover:text-accent" title="收起" aria-label="收起">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14h6v6"/><path d="M20 10h-6V4"/><path d="M14 10l7-7"/><path d="M3 21l7-7"/></svg>
              </button>`
            : ''
        }
        ${
          pendingReply
            ? `<div data-reply-chip class="mb-3 flex items-center gap-2 rounded-lg border-l-2 border-accent bg-line/40 px-3 py-2 text-xs">
                <span class="font-medium text-accent">引用 ${escapeHtml(formatMemoDate(pendingReply.createdAt))} 的 memo</span>
                <span class="line-clamp-1 flex-1 text-muted">${escapeHtml(pendingReply.text || '（图片）')}</span>
                <button data-reply-clear type="button" class="shrink-0 text-muted transition-colors hover:text-red-500" title="取消引用">×</button>
              </div>`
            : ''
        }
        <div class="relative ${composerFullscreen ? 'flex min-h-0 flex-1 flex-col' : ''}">
          <textarea data-composer-text ${composerFullscreen ? '' : 'rows="3"'} placeholder="写点什么…" class="w-full resize-none bg-transparent text-sm leading-relaxed outline-none placeholder:text-muted ${
            composerFullscreen ? 'min-h-0 flex-1 text-base' : ''
          }"></textarea>
          ${
            composerFullscreen
              ? ''
              : `<button data-composer-maximize type="button" class="absolute bottom-1 right-2 flex h-6 w-6 items-center justify-center rounded-md text-muted transition-colors hover:bg-line/60 hover:text-accent" title="全屏编辑" aria-label="全屏编辑">
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14h6v6"/><path d="M20 10h-6V4"/><path d="M14 10l7-7"/><path d="M3 21l7-7"/></svg>
                </button>`
          }
          <div data-tag-suggest class="absolute left-0 right-0 top-full z-20 mt-1 hidden overflow-hidden rounded-xl border border-line bg-surface py-1 shadow-lg"></div>
        </div>
        <div data-composer-preview class="mt-3 flex flex-wrap gap-2"></div>
        <div data-url-input-area class="hidden mt-3 flex items-center gap-2">
          <input data-url-input type="text" placeholder="https://你的图床.com/xxx.png" class="min-w-0 flex-1 rounded-lg border border-line bg-transparent px-3 py-2 text-sm outline-none placeholder:text-muted focus:border-accent">
          <button data-url-add type="button" class="rounded-lg bg-accent px-3 py-2 text-xs text-bg transition-opacity hover:opacity-90">添加</button>
          <button data-url-cancel type="button" class="rounded-lg px-3 py-2 text-xs text-muted transition-colors hover:text-ink">取消</button>
        </div>
        <div class="mt-3 flex items-center justify-between gap-3">
          <div class="flex items-center gap-2">
            <button data-attach type="button" class="flex items-center gap-1.5 rounded-lg border border-line px-3 py-1.5 text-xs text-muted transition-colors hover:border-accent hover:text-accent">📷 本地上传</button>
            <button data-attach-url type="button" class="flex items-center gap-1.5 rounded-lg border border-line px-3 py-1.5 text-xs text-muted transition-colors hover:border-accent hover:text-accent">🔗 图床链接</button>
            <input data-file-input type="file" accept="image/*" multiple class="hidden">
          </div>
          <button data-submit type="button" class="rounded-lg bg-accent px-5 py-1.5 text-sm text-bg transition-opacity hover:opacity-90">发布</button>
        </div>
      </div>`
    bindComposer()
  }

  function bindComposer() {
    composerBox.querySelector('[data-attach]')?.addEventListener('click', () => {
      composerBox.querySelector<HTMLInputElement>('[data-file-input]')?.click()
    })
    composerBox.querySelector<HTMLInputElement>('[data-file-input]')?.addEventListener('change', (e) => {
      const input = e.target as HTMLInputElement
      const files = Array.from(input.files ?? [])
      if (pendingImages.length + files.length > MAX_LOCAL_IMAGES) {
        showError(`本地上传最多 ${MAX_LOCAL_IMAGES} 张图片`)
        input.value = ''
        return
      }
      pendingImages = [...pendingImages, ...files].slice(0, MAX_LOCAL_IMAGES)
      input.value = ''
      renderPreview()
    })
    composerBox.querySelector('[data-attach-url]')?.addEventListener('click', () => {
      const area = composerBox.querySelector<HTMLElement>('[data-url-input-area]')
      area?.classList.remove('hidden')
      composerBox.querySelector<HTMLInputElement>('[data-url-input]')?.focus()
    })
    composerBox.querySelector('[data-url-cancel]')?.addEventListener('click', () => {
      const area = composerBox.querySelector<HTMLElement>('[data-url-input-area]')
      const input = composerBox.querySelector<HTMLInputElement>('[data-url-input]')
      area?.classList.add('hidden')
      if (input) input.value = ''
    })
    composerBox.querySelector('[data-url-add]')?.addEventListener('click', () => {
      const input = composerBox.querySelector<HTMLInputElement>('[data-url-input]')
      const area = composerBox.querySelector<HTMLElement>('[data-url-input-area]')
      const url = input?.value.trim() ?? ''
      if (!url) return
      if (!isImageUrl(url)) {
        showError('请输入以 http:// 或 https:// 开头的图片链接')
        return
      }
      if (pendingExternalImages.length + 1 > MAX_EXTERNAL_IMAGES) {
        showError(`图床链接最多 ${MAX_EXTERNAL_IMAGES} 张`)
        return
      }
      pendingExternalImages.push(url)
      if (input) input.value = ''
      area?.classList.add('hidden')
      renderPreview()
    })
    composerBox.querySelector('[data-reply-clear]')?.addEventListener('click', () => {
      pendingReply = null
      renderComposer()
      renderPreview()
    })
    composerBox.querySelector<HTMLTextAreaElement>('[data-composer-text]')?.addEventListener('input', onComposerInput)
    composerBox.querySelector<HTMLTextAreaElement>('[data-composer-text]')?.addEventListener('keydown', onComposerKeydown)
    composerBox.querySelector('[data-composer-maximize]')?.addEventListener('click', () => {
      composerText = composerBox.querySelector<HTMLTextAreaElement>('[data-composer-text]')?.value ?? ''
      composerFullscreen = true
      document.body.style.overflow = 'hidden'
      closeSuggestions()
      renderComposer()
      renderPreview()
      const ta = composerBox.querySelector<HTMLTextAreaElement>('[data-composer-text]')
      if (ta) {
        ta.value = composerText
        ta.focus()
      }
    })
    composerBox.querySelector('[data-composer-close]')?.addEventListener('click', closeComposerFullscreen)
    composerBox.querySelector<HTMLElement>('[data-tag-suggest]')?.addEventListener('mousedown', (e) => e.preventDefault())
    composerBox.querySelector<HTMLElement>('[data-tag-suggest]')?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-suggest-tag]')
      if (btn?.dataset.suggestTag) applySuggestion(btn.dataset.suggestTag)
    })
    composerBox.querySelector('[data-submit]')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement
      const textarea = composerBox.querySelector<HTMLTextAreaElement>('[data-composer-text]')
      const text = textarea?.value ?? ''
      if (!text.trim() && pendingImages.length === 0 && pendingExternalImages.length === 0) return
      btn.disabled = true
      btn.textContent = '发布中…'
      clearError()
      try {
        await postMemo(text, pendingImages, pendingExternalImages, pendingReply?.id)
        textarea!.value = ''
        composerText = ''
        pendingImages = []
        pendingExternalImages = []
        pendingReply = null
        composerFullscreen = false
        document.body.style.overflow = ''
        closeSuggestions()
        renderComposer()
        renderPreview()
        await load()
      } catch (err) {
        showError(err instanceof Error ? err.message : '发布失败，请重试')
      } finally {
        btn.disabled = false
        btn.textContent = '发布'
      }
    })
  }

  function closeComposerFullscreen() {
    composerText = composerBox.querySelector<HTMLTextAreaElement>('[data-composer-text]')?.value ?? ''
    composerFullscreen = false
    document.body.style.overflow = ''
    closeSuggestions()
    renderComposer()
    renderPreview()
    const ta = composerBox.querySelector<HTMLTextAreaElement>('[data-composer-text]')
    if (ta) {
      ta.value = composerText
      ta.focus()
    }
  }

  function renderPreview() {
    const preview = composerBox.querySelector<HTMLElement>('[data-composer-preview]')
    if (!preview) return
    const total = pendingImages.length + pendingExternalImages.length
    if (total === 0) {
      preview.innerHTML = ''
      return
    }

    const fileItems = pendingImages
      .map((f, i) => {
        const url = URL.createObjectURL(f)
        return `<div class="relative">
          <img src="${url}" class="h-20 w-20 rounded-lg border border-line object-cover">
          <button data-remove-img="${i}" type="button" class="absolute -right-1.5 -top-1.5 flex h-5 w-5 items-center justify-center rounded-full bg-red-500 text-xs text-white">×</button>
        </div>`
      })

    const urlItems = pendingExternalImages
      .map((url, i) => {
        return `<div class="relative">
          <img src="${escapeHtml(url)}" class="h-20 w-20 rounded-lg border border-line object-cover">
          <button data-remove-url="${i}" type="button" class="absolute -right-1.5 -top-1.5 flex h-5 w-5 items-center justify-center rounded-full bg-red-500 text-xs text-white">×</button>
        </div>`
      })

    preview.innerHTML = [...fileItems, ...urlItems].join('')

    preview.querySelectorAll<HTMLButtonElement>('[data-remove-img]').forEach((btn) => {
      btn.addEventListener('click', () => {
        pendingImages = pendingImages.filter((_, i) => i !== Number(btn.dataset.removeImg))
        renderPreview()
      })
    })
    preview.querySelectorAll<HTMLButtonElement>('[data-remove-url]').forEach((btn) => {
      btn.addEventListener('click', () => {
        pendingExternalImages = pendingExternalImages.filter((_, i) => i !== Number(btn.dataset.removeUrl))
        renderPreview()
      })
    })
  }

  function renderAvatar(): string {
    if (siteConfig.avatar) {
      return `<img src="${escapeHtml(siteConfig.avatar)}" alt="${escapeHtml(siteConfig.author)}" class="h-10 w-10 shrink-0 rounded-full object-cover" />`
    }
    return `<div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-accent/15 font-serif text-lg text-accent">${escapeHtml(siteConfig.author.charAt(0).toUpperCase())}</div>`
  }

  function filteredMemos(): ViewMemo[] {
    return memos.filter((m) => {
      if (activeTag && !(m._tags ?? []).includes(activeTag)) return false
      if (searchQuery) {
        const inText = m.text.toLowerCase().includes(searchQuery)
        const inTags = (m._tags ?? []).some((t) => t.toLowerCase().includes(searchQuery))
        if (!inText && !inTags) return false
      }
      return true
    })
  }

  function renderList() {
    renderStatus()
    if (memos.length === 0) {
      emptyBox.classList.remove('hidden')
      listBox.innerHTML = ''
      return
    }
    emptyBox.classList.add('hidden')
    const shown = filteredMemos()
    if (shown.length === 0) {
      listBox.innerHTML = `<p class="rounded-xl border border-line bg-surface p-6 text-center text-sm text-muted">没有匹配的 Memo · <button data-status-clear-all type="button" class="text-accent hover:underline">清除过滤</button></p>`
      bindList()
      return
    }
    listBox.innerHTML = shown
      .map(
        (m) => `
        <div data-memo-id="${m.id}" class="scroll-mt-20 rounded-2xl border border-line bg-surface p-5">
          <div class="flex items-center gap-3">
            ${renderAvatar()}
            <div class="min-w-0">
              <p class="text-sm font-semibold">${escapeHtml(siteConfig.author)}</p>
              <p class="text-xs text-muted">${escapeHtml(formatMemoDate(m.createdAt))}</p>
            </div>
            <div class="ml-auto flex items-center gap-1">
              ${
                getToken()
                  ? `<button data-reply="${m.id}" type="button" class="flex h-7 w-7 items-center justify-center rounded-full text-muted transition-colors hover:bg-line/60 hover:text-accent" title="引用">${REPLY_SVG}</button>
                  <button data-delete="${m.id}" type="button" class="flex h-7 w-7 items-center justify-center rounded-full text-muted transition-colors hover:bg-red-500/10 hover:text-red-500" title="删除">${TRASH_SVG}</button>`
                  : ''
              }
            </div>
          </div>
          ${m.replyTo ? renderQuote(m) : ''}
          ${
            m.text
              ? `<p data-memo-text class="mt-3 whitespace-pre-wrap break-words text-sm leading-relaxed line-clamp-8">${renderMemoText(m.text)}</p>
                 <div class="mt-1 flex justify-end">
                   <button data-show-more="${m.id}" type="button" class="hidden text-xs font-medium text-accent hover:underline">展开全文</button>
                 </div>`
              : ''
          }
          ${renderImages(m.images, m.id)}
        </div>`
      )
      .join('')
    bindList()
  }

  function renderQuote(m: Memo): string {
    const target = memos.find((x) => x.id === m.replyTo)
    const date = target ? formatMemoDate(target.createdAt) : ''
    const snippet = (target?.text || '（已删除的 memo）').slice(0, 80)
    return `<div data-jump="${m.replyTo}" class="mt-3 flex cursor-pointer items-center gap-2 rounded-lg border-l-2 border-accent/40 bg-line/40 px-3 py-2 text-xs text-muted transition-colors hover:text-accent">
      <span class="shrink-0 font-medium">${escapeHtml(date ? `引用 · ${date}` : '引用')}</span>
      <span class="line-clamp-1 flex-1">${escapeHtml(snippet)}</span>
    </div>`
  }

  function renderImages(images: string[], memoId: string): string {
    if (images.length === 0) return ''
    const isSingle = images.length === 1
    const cols = isSingle ? 'grid-cols-1' : images.length > 4 ? 'grid-cols-3' : 'grid-cols-2'
    const tile = (p: string, i: number) => {
      const url = escapeHtml(memoImageUrl(p))
      if (isSingle) {
        return `<a href="${url}" data-lightbox-open data-lightbox-index="${i}" data-lightbox-url="${url}" class="block overflow-hidden rounded-xl border border-line bg-line/30 transition-opacity hover:opacity-95">
          <img src="${url}" loading="lazy" class="w-full object-contain" style="max-height:24rem">
        </a>`
      }
      return `<a href="${url}" data-lightbox-open data-lightbox-index="${i}" data-lightbox-url="${url}" class="relative block aspect-square overflow-hidden rounded-xl border border-line bg-line/30 transition-opacity hover:opacity-95">
        <img src="${url}" loading="lazy" class="absolute inset-0 h-full w-full object-cover">
      </a>`
    }
    const grid = (items: string[], offset: number) =>
      `<div class="mt-3 grid ${cols} gap-2">${items.map((p, i) => tile(p, offset + i)).join('')}</div>`
    const shown = images.slice(0, 9)
    const rest = images.slice(9)
    return (
      grid(shown, 0) +
      (rest.length
        ? `<div data-more-images class="hidden">${grid(rest, shown.length)}</div>
           <div class="mt-2 flex justify-end">
             <button data-view-all-images="${memoId}" data-total="${images.length}" type="button" class="text-xs font-medium text-accent hover:underline">查看全部 ${images.length} 张</button>
           </div>`
        : '')
    )
  }

  const lightbox = document.querySelector<HTMLElement>('[data-lightbox]')
  const lightboxImg = document.querySelector<HTMLImageElement>('[data-lightbox-img]')
  const lightboxCounter = document.querySelector<HTMLElement>('[data-lightbox-counter]')

  function openLightbox(urls: string[], index: number) {
    lightboxImages = urls
    lightboxIndex = Math.max(0, Math.min(index, urls.length - 1))
    updateLightbox()
    lightbox?.classList.remove('hidden')
    lightbox?.classList.add('flex')
    lightbox?.setAttribute('aria-hidden', 'false')
    document.body.style.overflow = 'hidden'
  }

  function closeLightbox() {
    lightbox?.classList.add('hidden')
    lightbox?.classList.remove('flex')
    lightbox?.setAttribute('aria-hidden', 'true')
    document.body.style.overflow = ''
  }

  function updateLightbox() {
    if (lightboxImg) lightboxImg.src = lightboxImages[lightboxIndex]
    if (lightboxCounter) lightboxCounter.textContent = `${lightboxIndex + 1} / ${lightboxImages.length}`
  }

  function showPrev() {
    if (lightboxImages.length <= 1) return
    lightboxIndex = (lightboxIndex - 1 + lightboxImages.length) % lightboxImages.length
    updateLightbox()
  }

  function showNext() {
    if (lightboxImages.length <= 1) return
    lightboxIndex = (lightboxIndex + 1) % lightboxImages.length
    updateLightbox()
  }

  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox()
  })
  document.querySelector('[data-lightbox-close]')?.addEventListener('click', closeLightbox)
  document.querySelector('[data-lightbox-prev]')?.addEventListener('click', (e) => {
    e.stopPropagation()
    showPrev()
  })
  document.querySelector('[data-lightbox-next]')?.addEventListener('click', (e) => {
    e.stopPropagation()
    showNext()
  })
  document.addEventListener('keydown', (e) => {
    if (!lightbox || lightbox.classList.contains('hidden')) return
    if (e.key === 'Escape') closeLightbox()
    if (e.key === 'ArrowLeft') showPrev()
    if (e.key === 'ArrowRight') showNext()
  })

  function bindList() {
    listBox.querySelectorAll<HTMLButtonElement>('[data-delete]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (!confirm('确定删除这条 Memo？')) return
        clearError()
        try {
          await deleteMemo(btn.dataset.delete ?? '')
          await load()
        } catch (err) {
          showError(err instanceof Error ? err.message : '删除失败')
        }
      })
    })
    listBox.querySelectorAll<HTMLButtonElement>('[data-reply]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const m = memos.find((x) => x.id === btn.dataset.reply)
        if (!m) return
        pendingReply = m
        renderComposer()
        renderPreview()
        composerBox.querySelector<HTMLTextAreaElement>('[data-composer-text]')?.focus()
      })
    })
    listBox.querySelectorAll<HTMLElement>('[data-jump]').forEach((el) => {
      el.addEventListener('click', () => {
        const id = el.getAttribute('data-jump')
        if (!id) return
        let target = listBox.querySelector<HTMLElement>(`[data-memo-id="${id}"]`)
        // 目标被标签/搜索过滤掉时,先清除过滤再跳
        if (!target && (activeTag || searchQuery)) {
          activeTag = null
          searchQuery = ''
          updateSearchInput()
          syncHash()
          renderList()
          target = listBox.querySelector<HTMLElement>(`[data-memo-id="${id}"]`)
        }
        if (!target) return
        target.scrollIntoView({ behavior: 'smooth', block: 'start' })
        target.classList.add('ring-2', 'ring-accent')
        setTimeout(() => target.classList.remove('ring-2', 'ring-accent'), 2000)
      })
    })

    listBox.querySelectorAll<HTMLAnchorElement>('[data-tag-link]').forEach((a) => {
      a.addEventListener('click', (e) => {
        e.preventDefault()
        const tag = a.dataset.tagLink
        if (tag) applyTag(tag)
      })
    })

    listBox.querySelector('[data-status-clear-all]')?.addEventListener('click', () => {
      activeTag = null
      searchQuery = ''
      updateSearchInput()
      syncHash()
      renderList()
    })

    listBox.querySelectorAll<HTMLElement>('[data-lightbox-open]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault()
        const card = el.closest('[data-memo-id]')
        const urls = Array.from(card?.querySelectorAll<HTMLElement>('[data-lightbox-url]') ?? [])
          .map((a) => a.dataset.lightboxUrl ?? '')
          .filter(Boolean)
        const index = Number(el.dataset.lightboxIndex)
        openLightbox(urls, index)
      })
    })

    // 长度超过 8 行的正文才显示“展开全文”
    listBox.querySelectorAll<HTMLElement>('[data-memo-text]').forEach((el) => {
      const btn = el.closest('[data-memo-id]')?.querySelector<HTMLButtonElement>('[data-show-more]')
      if (btn && el.scrollHeight > el.clientHeight + 1) btn.classList.remove('hidden')
    })
    listBox.querySelectorAll<HTMLButtonElement>('[data-show-more]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.showMore ?? ''
        const el = btn.closest('[data-memo-id]')?.querySelector<HTMLElement>('[data-memo-text]')
        if (!el) return
        if (expandedText.has(id)) {
          expandedText.delete(id)
          el.classList.add('line-clamp-8')
          btn.textContent = '展开全文'
        } else {
          expandedText.add(id)
          el.classList.remove('line-clamp-8')
          btn.textContent = '收起'
        }
      })
    })
    listBox.querySelectorAll<HTMLButtonElement>('[data-view-all-images]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.viewAllImages ?? ''
        const more = btn.closest('[data-memo-id]')?.querySelector<HTMLElement>('[data-more-images]')
        if (!more) return
        if (expandedImages.has(id)) {
          expandedImages.delete(id)
          more.classList.add('hidden')
          btn.textContent = `查看全部 ${btn.dataset.total ?? ''} 张`
        } else {
          expandedImages.add(id)
          more.classList.remove('hidden')
          btn.textContent = '收起'
        }
      })
    })
  }

  function extractTags(text: string): string[] {
    const tags: string[] = []
    for (const m of text.matchAll(TAG_RE)) {
      if (!tags.includes(m[1])) tags.push(m[1])
    }
    return tags
  }

  function renderMemoText(text: string): string {
    return escapeHtml(text).replace(TAG_RE, (full, tag: string) => {
      return `<a href="#tag=${encodeURIComponent(tag)}" data-tag-link="${tag}" class="cursor-pointer font-medium text-accent hover:underline">${full}</a>`
    })
  }

  function buildTagVocab(): string[] {
    const seen = new Set<string>()
    const list: string[] = []
    for (const m of memos) {
      for (const t of m._tags ?? []) {
        if (!seen.has(t)) {
          seen.add(t)
          list.push(t)
        }
      }
    }
    return list
  }

  function tagFromHash(): string | null {
    const m = window.location.hash.match(/^#tag=([^&]+)/)
    if (!m) return null
    try {
      return decodeURIComponent(m[1])
    } catch {
      return null
    }
  }

  function syncHash() {
    const next = activeTag ? `#tag=${encodeURIComponent(activeTag)}` : ''
    if (window.location.hash !== next) history.replaceState(null, '', next)
  }

  function applyTag(tag: string) {
    activeTag = tag
    syncHash()
    renderList()
  }

  function renderStatus() {
    if (!activeTag && !searchQuery) {
      statusBox.classList.add('hidden')
      statusBox.innerHTML = ''
      return
    }
    const chips = [
      activeTag
        ? `<button data-status-clear-tag type="button" class="flex items-center gap-1 rounded-full border border-accent/40 bg-accent/10 px-3 py-1 text-accent transition-colors hover:border-accent">#${escapeHtml(activeTag)}<span class="text-xs">×</span></button>`
        : '',
      searchQuery
        ? `<button data-status-clear-search type="button" class="flex items-center gap-1 rounded-full border border-line px-3 py-1 transition-colors hover:border-accent hover:text-accent">“${escapeHtml(searchQuery)}”<span class="text-xs">×</span></button>`
        : '',
      memos.length > 0 ? `<span class="px-1">${filteredMemos().length} / ${memos.length} 条</span>` : '',
    ]
    statusBox.classList.remove('hidden')
    statusBox.innerHTML = chips.join('')
    statusBox.querySelector('[data-status-clear-tag]')?.addEventListener('click', () => {
      activeTag = null
      syncHash()
      renderList()
    })
    statusBox.querySelector('[data-status-clear-search]')?.addEventListener('click', () => {
      searchQuery = ''
      updateSearchInput()
      renderList()
    })
  }

  function updateSearchInput() {
    searchBox.value = searchQuery
  }

  function onComposerInput() {
    const ta = composerBox.querySelector<HTMLTextAreaElement>('[data-composer-text]')
    if (!ta) return
    composerText = ta.value
    const caret = ta.selectionStart ?? ta.value.length
    const before = ta.value.slice(0, caret)
    const m = before.match(TAG_CARET_RE)
    if (!m) {
      suggestOpen = false
      renderSuggestions()
      return
    }
    const prefix = m[1] ?? ''
    suggestTokenStart = m.index ?? 0
    suggestCaret = caret
    suggestList = tagVocab
      .filter((t) => t.toLowerCase().startsWith(prefix.toLowerCase()))
      .slice(0, MAX_SUGGESTIONS)
    suggestIndex = 0
    suggestOpen = suggestList.length > 0
    renderSuggestions()
  }

  function onComposerKeydown(e: KeyboardEvent) {
    if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
      e.preventDefault()
      composerBox.querySelector<HTMLButtonElement>('[data-submit]')?.click()
      return
    }
    if (e.key === 'Escape' && composerFullscreen) {
      e.preventDefault()
      closeComposerFullscreen()
      return
    }
    if (!suggestOpen || e.isComposing) return
    if (e.key === 'ArrowDown') {
      e.preventDefault()
      suggestIndex = (suggestIndex + 1) % suggestList.length
      renderSuggestions()
    } else if (e.key === 'ArrowUp') {
      e.preventDefault()
      suggestIndex = (suggestIndex - 1 + suggestList.length) % suggestList.length
      renderSuggestions()
    } else if (e.key === 'Enter') {
      const tag = suggestList[suggestIndex]
      if (tag) {
        e.preventDefault()
        applySuggestion(tag)
      }
    } else if (e.key === 'Escape') {
      e.preventDefault()
      suggestOpen = false
      renderSuggestions()
    }
  }

  function renderSuggestions() {
    const suggestBox = composerBox.querySelector<HTMLElement>('[data-tag-suggest]')
    if (!suggestBox) return
    if (!suggestOpen || suggestList.length === 0) {
      suggestBox.classList.add('hidden')
      return
    }
    suggestBox.innerHTML = suggestList
      .map(
        (t, i) =>
          `<button type="button" data-suggest-tag="${escapeHtml(t)}" class="flex w-full items-center gap-1.5 px-3 py-1.5 text-left text-sm transition-colors ${
            i === suggestIndex ? 'bg-accent/10 text-accent' : 'text-ink hover:bg-line/60'
          }"><span class="text-accent">#</span>${escapeHtml(t)}</button>`
      )
      .join('')
    suggestBox.classList.remove('hidden')
  }

  function applySuggestion(tag: string) {
    const ta = composerBox.querySelector<HTMLTextAreaElement>('[data-composer-text]')
    if (!ta) return
    const next = ta.value.slice(0, suggestTokenStart) + '#' + tag + ' ' + ta.value.slice(suggestCaret)
    ta.value = next
    suggestOpen = false
    suggestCaret = suggestTokenStart + 1 + tag.length + 1
    ta.setSelectionRange(suggestCaret, suggestCaret)
    renderSuggestions()
    ta.focus()
  }

  function closeSuggestions() {
    suggestOpen = false
    renderSuggestions()
  }

  async function load() {
    clearError()
    listBox.innerHTML = `<p class="p-4 text-center text-sm text-muted">加载中…</p>`
    try {
      memos = await fetchMemos()
    } catch {
      memos = []
    }
    for (const m of memos) {
      m._tags = extractTags(m.text ?? '')
    }
    tagVocab = buildTagVocab()
    renderList()
  }

  activeTag = tagFromHash()
  window.addEventListener('hashchange', () => {
    const tag = tagFromHash()
    if (tag !== activeTag) {
      activeTag = tag
      renderList()
    }
  })
  searchBox.addEventListener('input', () => {
    searchQuery = searchBox.value.trim().toLowerCase()
    renderList()
  })
  renderAuth()
  renderComposer()
  load()
</script>
