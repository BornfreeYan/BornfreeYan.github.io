---
interface Props {
  current: number
  pageCount: number
}

const { current, pageCount } = Astro.props
const pageUrl = (n: number) => (n === 1 ? '/articles' : `/articles/page/${n}`)
---

<nav class="mt-10 flex flex-wrap items-center justify-center gap-2 text-sm">
  {
    current > 1 && (
      <a
        href={pageUrl(current - 1)}
        class="rounded-lg border border-line px-3 py-1.5 transition-colors hover:border-accent hover:text-accent"
      >
        上一页
      </a>
    )
  }
  {
    Array.from({ length: pageCount }, (_, i) => i + 1).map((n) => (
      <a
        href={pageUrl(n)}
        aria-current={n === current ? 'page' : undefined}
        class:list={[
          'rounded-lg px-3 py-1.5 transition-colors',
          n === current
            ? 'bg-accent text-bg'
            : 'border border-line hover:border-accent hover:text-accent',
        ]}
      >
        {n}
      </a>
    ))
  }
  {
    current < pageCount && (
      <a
        href={pageUrl(current + 1)}
        class="rounded-lg border border-line px-3 py-1.5 transition-colors hover:border-accent hover:text-accent"
      >
        下一页
      </a>
    )
  }
</nav>