---
import { siteConfig } from '../config'
import Marquee from './Marquee.astro'
---

<section class="relative flex min-h-[72vh] flex-col items-center justify-center px-4 py-24 text-center">
  <div class="max-w-3xl">
    <p class="font-serif text-2xl italic leading-relaxed text-ink sm:text-4xl">
      {siteConfig.sloganEn}
    </p>
    <p class="mt-5 text-base text-muted sm:text-xl">{siteConfig.sloganZh}</p>
  </div>
  <div class="mt-14 w-full max-w-3xl">
    <Marquee />
  </div>
</section>