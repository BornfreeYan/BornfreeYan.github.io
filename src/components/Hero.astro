---
import { siteConfig, visibleSocials } from '../config'
import Marquee from './Marquee.astro'
import Icon from './Icon.astro'

const socials = visibleSocials()
---

<section class="relative flex min-h-svh flex-col overflow-hidden">
  <div class="flex flex-1 flex-col items-center justify-center px-6 pb-10 pt-28 text-center">
    <p class="max-w-6xl font-display text-4xl italic leading-[1.15] tracking-wide text-ink sm:text-5xl md:text-6xl lg:text-7xl">
      {siteConfig.sloganEn}
    </p>
    <p class="mt-6 text-base text-muted sm:text-lg md:text-xl">
      {siteConfig.sloganZh}
    </p>
    <div class="mt-10 flex items-center gap-3">
      {
        socials.map((s) => (
          <a
            href={s.url}
            target={s.url.startsWith('http') ? '_blank' : undefined}
            rel={s.url.startsWith('http') ? 'noopener noreferrer' : undefined}
            aria-label={s.label}
            class="flex h-11 w-11 items-center justify-center rounded-full border border-line text-muted transition-colors hover:border-accent hover:text-accent"
          >
            <Icon name={s.icon} class="h-4 w-4" />
          </a>
        ))
      }
    </div>
  </div>
  <div class="w-full pb-8">
    <Marquee />
  </div>
</section>
