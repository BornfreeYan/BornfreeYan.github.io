---
import { siteConfig, visibleSocials } from '../config'
import Icon from './Icon.astro'
import EmailCopy from './EmailCopy.astro'

const socials = visibleSocials()
---

<section class="relative flex min-h-svh flex-col overflow-hidden">
  <div class="flex flex-1 flex-col items-center justify-center px-6 pb-12 pt-28 text-center">
    <p
      class="max-w-6xl font-display text-5xl font-medium italic leading-[1.12] tracking-[0.03em] text-ink sm:text-6xl md:text-7xl lg:text-8xl"
    >
      {siteConfig.sloganEn}
    </p>
    <p class="mt-7 text-sm text-muted sm:text-base md:text-lg">
      {siteConfig.sloganZh}
    </p>
    <div class="mt-14 flex flex-wrap items-center justify-center gap-4">
      {
        socials.map((s) =>
          s.icon === 'email' ? (
            <EmailCopy variant="lg" />
          ) : (
            <a
              href={s.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.label}
              title={s.label}
              class="flex h-14 w-14 items-center justify-center rounded-full border border-line text-muted transition-all hover:-translate-y-1 hover:border-accent hover:text-accent"
            >
              <Icon name={s.icon} class="h-5 w-5" />
            </a>
          )
        )
      }
    </div>
  </div>
</section>
