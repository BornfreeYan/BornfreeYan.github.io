---
import Icon from './Icon.astro'
import { siteConfig } from '../config'

interface Props {
  variant?: 'lg' | 'sm'
}

const { variant = 'lg' } = Astro.props
const email = siteConfig.socials.find((s) => s.icon === 'email')?.url ?? ''
const wrap = variant === 'lg' ? 'h-14 w-14' : 'h-9 w-9'
const iconSize = variant === 'lg' ? 'h-5 w-5' : 'h-4 w-4'
---

<button
  type="button"
  data-email-copy
  data-addr={email}
  aria-label="复制邮箱"
  class:list={[
    'group relative flex items-center justify-center rounded-full border border-line text-muted transition-all hover:border-accent hover:text-accent',
    wrap,
  ]}
>
  <Icon name="email" class={iconSize} />
  <span
    data-email-tip
    class="pointer-events-none absolute -top-9 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full bg-ink px-3 py-1 text-xs text-bg opacity-0 transition-opacity duration-150"
  >
    已复制 ✓
  </span>
</button>

<script>
  const btns = document.querySelectorAll<HTMLElement>('[data-email-copy]')
  btns.forEach((btn) => {
    const tip = btn.querySelector<HTMLElement>('[data-email-tip]')
    btn.addEventListener('click', async () => {
      const addr = btn.getAttribute('data-addr') ?? ''
      try {
        await navigator.clipboard.writeText(addr)
      } catch {
        /* 剪贴板不可用时保持静默 */
      }
      if (tip) {
        tip.classList.remove('opacity-0')
        setTimeout(() => tip.classList.add('opacity-0'), 1600)
      }
    })
  })
</script>
