---

<div class="flex flex-col gap-3">
  <p data-memo-placeholder class="rounded-xl border border-line bg-surface p-4 text-sm text-muted">
    加载中…
  </p>
  <div data-memo-recent class="hidden flex-col gap-3"></div>
</div>

<script>
  import { fetchMemos } from '../lib/memo'

  async function load() {
    const list = document.querySelector<HTMLElement>('[data-memo-recent]')
    const placeholder = document.querySelector<HTMLElement>('[data-memo-placeholder]')
    if (!list || !placeholder) return

    let memos: { text: string; createdAt: string }[] = []
    try {
      memos = await fetchMemos()
    } catch {
      memos = []
    }
    placeholder.classList.add('hidden')
    if (memos.length === 0) {
      list.classList.remove('hidden')
      list.innerHTML = `<p class="rounded-xl border border-line bg-surface p-4 text-sm text-muted">还没有 Memo</p>`
      return
    }
    const recent = memos.slice(0, 5)
    list.classList.remove('hidden')
    list.innerHTML = recent
      .map((m) => {
        const d = new Date(m.createdAt)
        const date = d.toLocaleDateString('zh-CN', {
          year: 'numeric',
          month: 'short',
          day: 'numeric',
        })
        const text = (m.text || '').replace(/\n+/g, ' ').slice(0, 80)
        return `<a href="/memos" class="group rounded-xl border border-line bg-surface p-4 transition-colors hover:border-accent/40">
          <p class="line-clamp-2 text-sm group-hover:text-accent">${escapeHtml(text || '（图片）')}</p>
          <p class="mt-2 text-xs text-muted">${date}</p>
        </a>`
      })
      .join('')
  }

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
  }

  load()
</script>