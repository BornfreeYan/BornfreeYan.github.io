---
import type { CollectionEntry } from 'astro:content'
import { formatDate, excerptFromMarkdown } from '../lib/format'

interface Props {
  article: CollectionEntry<'articles'>
  compact?: boolean
}

const { article, compact = false } = Astro.props
const { title, date, categories, tags, cover } = article.data
const excerpt = excerptFromMarkdown(article.body ?? '')
---

<a
  href={`/articles/${article.id}/`}
  class="group flex flex-col overflow-hidden rounded-2xl border border-line bg-surface transition-all hover:-translate-y-0.5 hover:border-accent/40 hover:shadow-md"
>
  {
    cover && !compact && (
      <div class="aspect-video w-full overflow-hidden bg-line/50">
        <img
          src={cover}
          alt={title}
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
      </div>
    )
  }
  <div class="p-5">
    <time class="text-xs text-muted">{formatDate(date)}</time>
    <h3
      class:list={[
        'mt-2 font-serif font-semibold leading-snug group-hover:text-accent',
        compact ? 'text-base' : 'text-lg',
      ]}
    >
      {title}
    </h3>
    {
      !compact && (
        <p class="mt-2 line-clamp-2 text-sm text-muted">{excerpt}</p>
      )
    }
    <div class="mt-3 flex flex-wrap gap-1.5">
      {categories.map((c) => (
        <span class="rounded-full bg-line/60 px-2 py-0.5 text-xs text-muted">{c}</span>
      ))}
      {tags.map((t) => (
        <span class="rounded-full border border-line px-2 py-0.5 text-xs text-muted">#{t}</span>
      ))}
    </div>
  </div>
</a>
