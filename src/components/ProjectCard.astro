---
import type { Project } from '../types'
import Icon from './Icon.astro'

interface Props {
  project: Project
}

const { project } = Astro.props
---

<article class="flex flex-col rounded-2xl border border-line bg-surface p-5 transition-all hover:-translate-y-0.5 hover:border-accent/40 hover:shadow-md">
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-serif text-lg font-semibold leading-snug">{project.title}</h3>
    {
      project.github && (
        <span
          data-stars={project.github}
          class="flex shrink-0 items-center gap-1 rounded-full border border-line px-2 py-0.5 text-xs text-muted"
        >
          <Icon name="star" class="h-3 w-3 text-accent" />
          <span data-stars-value>…</span>
        </span>
      )
    }
  </div>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{project.description}</p>
  <div class="mt-3 flex flex-wrap gap-1.5">
    {project.tags.map((t) => (
      <span class="rounded-full bg-line/60 px-2 py-0.5 text-xs text-muted">{t}</span>
    ))}
  </div>
  <div class="mt-4 flex gap-2">
    {
      project.github && (
        <a
          href={project.github}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1.5 rounded-lg border border-line px-3 py-1.5 text-sm text-muted transition-colors hover:border-accent hover:text-accent"
        >
          GitHub
          <Icon name="external" class="h-3.5 w-3.5" />
        </a>
      )
    }
    {
      project.demo && (
        <a
          href={project.demo}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1.5 rounded-lg bg-accent px-3 py-1.5 text-sm text-bg transition-opacity hover:opacity-90"
        >
          在线演示
          <Icon name="external" class="h-3.5 w-3.5" />
        </a>
      )
    }
  </div>
</article>