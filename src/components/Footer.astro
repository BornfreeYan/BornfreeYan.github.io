---
import { siteConfig, visibleSocials } from '../config'
import Icon from './Icon.astro'
import EmailCopy from './EmailCopy.astro'

const socials = visibleSocials()
const year = new Date().getFullYear()
---

<footer class="border-t border-line">
  <div class="mx-auto flex max-w-5xl flex-col items-center gap-4 px-4 py-10 text-sm text-muted md:flex-row md:justify-between">
    <div class="text-center md:text-left">
      <p class="font-display text-xl font-medium tracking-[0.04em] text-ink">{siteConfig.author}</p>
      <p class="mt-1.5 font-display text-sm italic tracking-[0.12em] text-muted">
        Revere time, defend your attention.
      </p>
    </div>
    <div class="flex items-center gap-2.5">
      {
        socials.map((s) =>
          s.icon === 'email' ? (
            <EmailCopy variant="sm" />
          ) : (
            <a
              href={s.url}
              target="_blank"
              rel="noopener noreferrer"
              class="flex h-9 w-9 items-center justify-center rounded-full border border-line text-muted transition-colors hover:border-accent hover:text-accent"
              aria-label={s.label}
            >
              <Icon name={s.icon} class="h-4 w-4" />
            </a>
          )
        )
      }
    </div>
    <div class="text-center md:text-right">
      <p>© {year} {siteConfig.author}</p>
      <p class="mt-1 text-xs text-muted">Powered by Astro</p>
    </div>
  </div>
</footer>