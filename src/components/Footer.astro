---
import { siteConfig, visibleSocials } from '../config'
import Icon from './Icon.astro'

const socials = visibleSocials()
const year = new Date().getFullYear()
---

<footer class="border-t border-line">
  <div class="mx-auto flex max-w-5xl flex-col items-center gap-4 px-4 py-10 text-sm text-muted md:flex-row md:justify-between">
    <div class="text-center md:text-left">
      <p class="font-serif text-base font-semibold text-ink">{siteConfig.author}</p>
      <p class="mt-1">Revere time, defend your attention.</p>
    </div>
    <div class="flex items-center gap-2.5">
      {
        socials.map((s) => (
          <a
            href={s.url}
            target={s.url.startsWith('http') ? '_blank' : undefined}
            rel={s.url.startsWith('http') ? 'noopener noreferrer' : undefined}
            class="flex h-9 w-9 items-center justify-center rounded-full border border-line text-muted transition-colors hover:border-accent hover:text-accent"
            aria-label={s.label}
          >
            <Icon name={s.icon} class="h-4 w-4" />
          </a>
        ))
      }
    </div>
    <p>
      © {year} {siteConfig.author}
    </p>
  </div>
</footer>