---
import { siteConfig } from '../config'
import Icon from './Icon.astro'

const items = [
  { label: 'Home', href: '/' },
  { label: 'Project', href: '/projects' },
  { label: 'Article', href: '/articles', dropdown: true },
  { label: 'Memo', href: '/memos' },
  { label: 'About', href: '/about' },
]

const articleSub = [
  { label: 'Categories', href: '/categories' },
  { label: 'Tags', href: '/tags' },
  { label: 'Archive', href: '/archive' },
]
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/80 backdrop-blur">
  <nav class="mx-auto flex h-14 max-w-5xl items-center gap-1 px-4">
    <a href="/" class="mr-3 flex shrink-0 items-center gap-2.5 font-serif text-lg font-semibold">
      <img
        src="/favicon.png"
        alt="{siteConfig.title}"
        class="h-7 w-7 rounded-full object-cover"
      />
      <span>{siteConfig.title}</span>
    </a>

    <div class="hidden items-center gap-0.5 md:flex">
      {
        items.map((item) =>
          item.dropdown ? (
            <div class="group relative">
              <span class="flex cursor-default items-center gap-1 rounded-lg px-3 py-2 text-sm text-muted transition-colors">
                {item.label}
                <Icon name="chevron-down" class="h-3.5 w-3.5" />
              </span>
              <div class="invisible absolute left-0 top-full pt-2 opacity-0 transition-all duration-150 group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100">
                <div class="w-44 rounded-xl border border-line bg-surface p-1.5 shadow-lg">
                  {
                    articleSub.map((sub) => (
                      <a
                        href={sub.href}
                        class="block rounded-lg px-3 py-2 text-sm text-ink transition-colors hover:bg-line/60"
                      >
                        {sub.label}
                      </a>
                    ))
                  }
                </div>
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class="rounded-lg px-3 py-2 text-sm text-muted transition-colors hover:text-ink"
            >
              {item.label}
            </a>
          )
        )
      }
    </div>

    <div class="ml-auto flex items-center gap-0.5">
      <button
        data-search-open
        class="rounded-lg p-2 text-muted transition-colors hover:text-ink"
        aria-label="搜索"
      >
        <Icon name="search" class="h-5 w-5" />
      </button>
      <button
        data-theme-toggle
        class="rounded-lg p-2 text-muted transition-colors hover:text-ink"
        aria-label="切换明暗模式"
      >
        <Icon name="sun" class="hidden h-5 w-5 [data-theme='dark']:block" />
        <Icon name="moon" class="block h-5 w-5 [data-theme='dark']:hidden" />
      </button>
      <button
        data-menu-toggle
        class="rounded-lg p-2 text-muted transition-colors hover:text-ink md:hidden"
        aria-label="打开菜单"
      >
        <Icon name="menu" class="h-5 w-5" />
      </button>
    </div>
  </nav>

  <div data-mobile-menu class="hidden border-t border-line md:hidden">
    <div class="mx-auto flex max-w-5xl flex-col gap-1 px-4 py-3">
      {
        items.map((item) =>
          item.dropdown ? (
            <div class="flex flex-col">
              <span class="flex items-center gap-1 px-3 py-2 text-sm font-semibold text-ink">
                {item.label}
                <Icon name="chevron-down" class="h-3.5 w-3.5" />
              </span>
              <div class="mb-1 flex flex-col pl-4">
                {
                  articleSub.map((sub) => (
                    <a
                      href={sub.href}
                      class="rounded-lg px-3 py-2 text-sm text-muted transition-colors hover:text-ink"
                    >
                      {sub.label}
                    </a>
                  ))
                }
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class="rounded-lg px-3 py-2 text-sm text-muted transition-colors hover:text-ink"
            >
              {item.label}
            </a>
          )
        )
      }
    </div>
  </div>
</header>

<script>
  const themeBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')
  themeBtn?.addEventListener('click', () => {
    const html = document.documentElement
    const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark'
    html.setAttribute('data-theme', next)
    localStorage.setItem('theme', next)
  })

  const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')
  const mobileMenu = document.querySelector<HTMLElement>('[data-mobile-menu]')
  menuBtn?.addEventListener('click', () => {
    const hidden = mobileMenu?.classList.toggle('hidden') ?? true
    menuBtn.setAttribute('aria-label', hidden ? '打开菜单' : '关闭菜单')
  })
</script>